#!/usr/bin/env python3
"""
free -- a lightweight headless tutor over the free-model chain.

opencode is a general coding agent: every turn it loads a ~38k-token system
prompt with tool definitions and re-sends the whole conversation, which is why it
exhausts the free tiers. A tutoring turn is not that. It is three steps -- read
the lesson, read the handwriting, write one card -- and this script does exactly
those as plain completions over the same free-provider chain the media fleet
uses. Stdlib only, no session, no tool loop: what is on disk is the whole state,
which is precisely what makes a transcript survive the host.

Run per turn by `tutor headless`, with the inbox text as the only argument. It
reads the course's contract and method, runs `board recap`, OCRs anything the
student sent, asks the free chain for ONE card, and writes it.
"""

import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request

TOOL = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, TOOL)
from tutorboard import freechain, handoff, reasoning

BOARD = os.path.join(TOOL, "bin", "board")

# Which models this machine can teach with is not written down here any more.
# It used to be a tuple at the top of this file, and on 7 September 2026 two of
# its five OpenRouter entries answered 404 -- retired from the free tier -- while
# the file went on naming them. A free tier's catalogue moves; a constant does
# not; and the difference between the two is a debugging session. `freechain`
# asks the providers what they actually serve, ranks it, remembers what has died
# and keeps a floor for a night with no network. See tutorboard/freechain.py.
UA = freechain.UA
read_key = freechain.read_key


def post_json(url, key, payload, timeout=180):
    req = urllib.request.Request(
        url, data=json.dumps(payload).encode("utf-8"), method="POST",
        headers={"Authorization": "Bearer " + key,
                 "Content-Type": "application/json", "User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as resp:  # noqa: S310
        return json.loads(resp.read().decode("utf-8", "replace"))


def chat(messages, max_tokens=2048, reject=None, chain=None, note=None):
    """One plain completion over the free chain; moves on at every failure.
    Raises when nothing on the chain answered.

    What comes back is the answer with the model's thinking taken out of it. That
    is not tidying: every model on this chain deliberates first, and a reply whose
    reasoning was forwarded into `content` becomes a card, and a card is the
    lesson. A reply that was ALL thinking counts as empty and the chain moves on,
    which is right -- the next model is a better answer than the last one's
    private notes.

    `reject` is the same idea for thinking that carries no tag at all, which no
    strip can remove because there is nothing in it to remove. The caller says
    what an unusable reply looks like for ITS purpose -- a card is written to the
    student, a handoff is written about them, so this cannot be one rule here --
    and a model that hands back deliberation is passed over for the next one.

    `note` is called with a line per model tried. `board doctor` passes one so a
    person can see the whole walk; a lesson turn does not, because the walk is
    only interesting when it ends badly and the log already has that.
    """
    chain = freechain.text_chain() if chain is None else chain
    if not chain:
        missing = freechain.missing_keys()
        raise RuntimeError(
            "no free model is reachable: no provider key on this machine (%s)"
            % ", ".join(missing) if missing else
            "no free model is reachable: every provider's catalogue came back empty")
    last = "no free provider answered"
    for link in chain:
        name, model = link["provider"], link["model"]
        key = read_key(link["key"])
        if not key:
            continue
        body = {"model": model, "messages": messages,
                "max_tokens": max_tokens, "temperature": 0.3}
        try:
            data = post_json(link["url"], key, dict(body, **link["quiet"]))
        except urllib.error.HTTPError as exc:
            detail = ""
            try:
                detail = exc.read().decode("utf-8", "replace")[:400]
            except OSError:
                pass
            # The provider says this model is gone rather than busy. Write it
            # down: a retired free model is retired for weeks, and rediscovering
            # that on every turn of every lesson costs a round trip each time.
            if freechain.reads_as_dead(exc.code, detail):
                freechain.bury(name, model)
                last = "%s/%s: retired from the free tier" % (name, model)
                if note:
                    note("%s/%s -- retired from the free tier, skipping from now on"
                         % (name, model))
                continue
            if exc.code != 400:
                last = "%s/%s: %s%s" % (name, model, exc,
                                        (" -- " + detail.strip()) if detail else "")
                if note:
                    note("%s/%s -- %s" % (name, model, exc))
                continue
            # It does not know the parameter that suppresses reasoning. Ask again
            # without it; the stripping below is what actually holds the line.
            try:
                data = post_json(link["url"], key, body)
            except (urllib.error.HTTPError, urllib.error.URLError, OSError) as exc2:
                last = "%s/%s: %s" % (name, model, exc2)
                if note:
                    note("%s/%s -- %s" % (name, model, exc2))
                continue
        except (urllib.error.URLError, OSError) as exc:
            last = "%s/%s: %s" % (name, model, exc)
            if note:
                note("%s/%s -- %s" % (name, model, exc))
            continue
        text = ((data.get("choices") or [{}])[0].get("message") or {}).get("content", "")
        said = (text or "").strip()
        text = reasoning.strip_reasoning(text)
        if text and reject and reject(text):
            last = "%s/%s deliberated instead of answering" % (name, model)
            if note:
                note("%s/%s -- deliberated instead of answering" % (name, model))
            continue
        if text:
            if note:
                note("%s/%s -- answered" % (name, model))
            return text
        last = ("%s/%s answered with nothing but its own thinking" % (name, model)
                if said else "%s/%s returned empty" % (name, model))
        if note:
            note("%s/%s -- %s" % (name, model,
                                  "only its own thinking" if said else "empty"))
    raise RuntimeError(last)


def ocr_image(path):
    """Read the student's page. Over the free vision chain, not a paid model.

    This used to name `qwen/qwen2.5-vl-72b-instruct`, which is a fine model and
    is not free -- so the tutor that exists in order to cost nothing was putting
    every handed-in page on a credit balance, and would have started answering
    "insufficient credits" to handwriting on the day that balance ran out, with
    nothing on the board to say why. Several free models take images now; the
    chain picks among them exactly as the text chain does.
    """
    import base64
    mime = "image/png" if path.lower().endswith(".png") else "image/jpeg"
    try:
        with open(path, "rb") as fh:
            b64 = base64.b64encode(fh.read()).decode()
    except OSError as exc:
        return "(could not read %s: %s)" % (path, exc)
    chain = freechain.vision_chain()
    if not chain:
        return ("(no free model on this machine can read an image; the page was "
                "not transcribed)")
    prompt = ("Transcribe ALL handwriting and text on this page verbatim, including "
              "mathematical notation. Describe any diagrams precisely, so someone who "
              "cannot see the page can follow the working exactly.")
    message = [{"role": "user", "content": [
        {"type": "text", "text": prompt},
        {"type": "image_url", "image_url": {"url": "data:%s;base64,%s" % (mime, b64)}},
    ]}]
    try:
        # The vision model reasons as well, and this text is handed to the tutor
        # as the student's own working -- thinking left in it is read as
        # handwriting. `chat` strips it, which is why this goes through `chat`
        # rather than posting for itself as it used to.
        return chat(message, max_tokens=OCR_LIMIT, chain=chain)
    except RuntimeError as exc:
        return "(vision failed: %s)" % exc


def ocr(path):
    if path.lower().endswith(".pdf"):
        return ocr_pdf(path)
    return ocr_image(path)


def ocr_pdf(path):
    import glob
    tmp = tempfile.mkdtemp(prefix="free-ocr-")
    try:
        subprocess.run(["pdftoppm", "-png", "-r", "150", path, os.path.join(tmp, "p")],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)
        pages = sorted(glob.glob(os.path.join(tmp, "p-*.png")))
        out = []
        for i, page in enumerate(pages[:20], 1):
            out.append("--- page %d ---\n%s" % (i, ocr_image(page)))
        if len(pages) > 20:
            out.append("[%d further page(s) omitted]" % (len(pages) - 20))
        return "\n\n".join(out) if out else "(pdf produced no pages)"
    except (OSError, subprocess.TimeoutExpired) as exc:
        return "(pdf raster failed: %s)" % exc


def read(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def find_paths(text):
    """The inbox and recap name files as `file: <path>` / `slate: <path>` /
    `handwriting: <path>`. Collect the ones that are images or PDFs."""
    out = []
    for m in re.finditer(r"(?:file|slate|handwriting):\s*(\S+)", text):
        p = m.group(1)
        if p.lower().endswith((".png", ".jpg", ".jpeg", ".webp", ".pdf")):
            out.append(p)
    return out


KINDS = ("lesson", "question", "correct", "wrong", "review", "note", "recap")


# The front matter, wherever in the reply it starts. Anchoring this at position
# zero was the second half of a leak worth remembering: a model that put anything
# at all in front of the opening `---` -- a stripped-out thought, a "here is the
# card:" -- did not just lose its title, it fell through to the branch that makes
# the WHOLE reply the body. The card then carried the preamble, and the preamble
# was the tutor talking to itself.
#
# The meta has to name a `kind` or a `title` to count, so a horizontal rule in
# the middle of a lesson is not mistaken for front matter.
FRONT_MATTER = re.compile(r"(?:\A|\n)[ \t]*---[ \t]*\n(.*?)\n[ \t]*---[ \t]*(?:\n|\Z)",
                          re.DOTALL)


def card_markdown(text):
    """The model replies with one card. Recover kind, title and body from the
    front-matter shape; fall back to a plain lesson card when it ignored it."""
    kind, title, body = "lesson", "", (text or "").strip()
    for m in FRONT_MATTER.finditer(text or ""):
        meta, rest = m.group(1), (text or "")[m.end():].strip()
        found = False
        for line in meta.splitlines():
            if ":" in line:
                k, v = line.split(":", 1)
                k = k.strip().lower()
                v = v.strip()
                if k == "kind" and v in KINDS:
                    kind, found = v, True
                elif k == "title":
                    title, found = v, True
        if found:
            body = rest
            break
    return kind, title, body


# A reply that plans the card rather than being the card opens with a lead-in and
# then says what the card "should" do. These markers catch that failure mode.
META_MARKERS = ("card body should", "the card should", "a card should",
                "should state", "should explain", "should describe", "should say",
                "step 1", "step 2", "steps:", "write a card that")


def extract_json(text):
    """Recover the JSON object from a reply that may open with prose or a fence."""
    t = (text or "").strip()
    t = re.sub(r"^```(json)?\s*", "", t, flags=re.IGNORECASE)
    t = t.rstrip("`").strip()
    start = min((i for i in (t.find("{"), t.find("[")) if i >= 0), default=-1)
    end = max(t.rfind("}"), t.rfind("]"))
    if start < 0 or end <= start:
        return {}
    try:
        data = json.loads(t[start:end + 1])
    except ValueError:
        return {}
    return data if isinstance(data, dict) else {}


def looks_meta(body):
    b = (body or "").strip()
    if not b:
        return False
    low = b.lower()
    first = (b.splitlines() or [b])[0].lower()
    if first.startswith(("the card", "card body", "a card", "this card", "the answer",
                         "write a card", "the response", "card:")):
        return True
    return any(m in low[:300] for m in META_MARKERS)


def parse_card(reply):
    """(kind, title, body) from a reply that may be JSON or markdown front matter."""
    data = extract_json(reply)
    if data and data.get("body"):
        kind = data.get("kind") if data.get("kind") in KINDS else "lesson"
        return kind, str(data.get("title") or "").strip(), (data.get("body") or "").strip()
    return card_markdown(reply)


# ---------------------------------------------------------------------------
# Budgets
# ---------------------------------------------------------------------------
# On every model of this chain `max_tokens` is NOT a length limit on the answer.
# It is a budget shared between the model's thinking and its answer, and the
# thinking goes first. A 550B model asked for a card under an 800-token cap can
# spend all 800 deliberating and return an empty `content` -- which reads here as
# "the model returned nothing", moves to the next model, and eventually writes
# the turn off. The chain looked broken; the budget was.
#
# So these are generous, because they cost nothing: every model here is free, and
# the only price of a larger budget is a few seconds. What keeps a card short is
# the instruction to write one card, which is where a length limit belongs.
BRIEF_LIMIT = 2000    # the distilled brief -- capped at 500 words by instruction
CARD_LIMIT = 2400     # one card
HANDOFF_LIMIT = 1800  # HANDOFF.md -- under 350 words by instruction
OCR_LIMIT = 3000      # a transcribed page, which can be long and must not be cut


def newest_mtime(paths):
    best = 0
    for p in paths:
        try:
            best = max(best, os.path.getmtime(p))
        except OSError:
            pass
    return best


def brief_sources(root):
    return (os.path.join(root, "AI_INSTRUCTIONS.md"),
            os.path.join(root, "live", "TEACHING.md"),
            os.path.join(root, "latex", "coursemacros.sty"),
            os.path.join(root, "HANDOFF.md"))


def chapter_now(root):
    try:
        with open(os.path.join(root, "live", "state.json"), "r", encoding="utf-8") as fh:
            return (json.load(fh) or {}).get("chapter") or ""
    except (OSError, ValueError):
        return ""


def build_brief(root):
    method = read(os.path.join(root, "live", "TEACHING.md"))
    contract = read(os.path.join(root, "AI_INSTRUCTIONS.md"))
    macros = read(os.path.join(root, "latex", "coursemacros.sty"))
    # Only this chapter's. A handoff about a chapter that has been closed is the
    # last chapter's unfinished business, and distilling it into the brief would
    # feed it to every turn of the new one.
    handoff_text = (read(os.path.join(root, "HANDOFF.md"))
               if handoff.handoff_applies(root, chapter_now(root)) else "")
    if not any((method, contract, handoff_text)):
        return ""
    prompt = (
        "Distill the following into ONE compact teaching brief of at most 500 words. "
        "Keep only what a tutor needs on every turn: the subject and its scope, the "
        "non-negotiable teaching rules, the notation and macro commands verbatim, and "
        "where the student is plus the single next thing to cover. Drop prose, examples "
        "and anything redundant.\n\n"
        "The teaching method:\n\n%s\n\n"
        "The course contract:\n\n%s\n\n"
        "The course's own macro commands:\n\n%s\n\n"
        "The handoff (where the last session left off):\n\n%s"
        % (method, contract, macros or "(none)", handoff_text or "(none)"))
    try:
        return chat([{"role": "user", "content": prompt}], max_tokens=BRIEF_LIMIT)
    except RuntimeError as exc:
        sys.stderr.write("free tutor: brief build failed: %s\n" % exc)
        return ""


def load_brief(root):
    """The compact session brief, distilled once and cached until its sources change.

    The contract, method and macros are stable within a session, but a stateless tutor
    would otherwise re-send ~20k tokens of them every turn. Distill them once into a
    few hundred words under live/, and re-send only that. Rebuilt when any source file
    is newer than the cache.
    """
    path = os.path.join(root, "live", ".brief")
    try:
        if os.path.getmtime(path) >= newest_mtime(brief_sources(root)):
            cached = read(path)
            # A brief written before this file learned to strip thinking is a
            # cache that goes on poisoning every turn until one of its sources
            # happens to change, which could be weeks. Repair it in place.
            clean = reasoning.strip_reasoning(cached)
            if clean != cached:
                try:
                    with open(path, "w", encoding="utf-8") as fh:
                        fh.write(clean)
                except OSError:
                    pass
            return clean
    except OSError:
        pass
    brief = build_brief(root)
    if brief:
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(brief)
        except OSError:
            pass
    return brief


def recap(root):
    p = subprocess.run([sys.executable, BOARD, "recap"], cwd=root,
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=60)
    return p.stdout.decode("utf-8", "replace")


def write_handoff(root):
    try:
        text = chat([{"role": "user", "content": (
            "Write HANDOFF.md for a tutoring session that just ended. Under 350 words. "
            "Cover, concretely: where the student got to by topic, what they got wrong "
            "and what the misunderstanding actually was, what they got right so it is not "
            "re-taught, and the single next thing to teach. No questions, no new "
            "teaching.\n\n"
            "The lesson (from `board recap`):\n\n%s" % recap(root))}],
            max_tokens=HANDOFF_LIMIT)
    except RuntimeError as exc:
        sys.stderr.write("free tutor: handoff failed: %s\n" % exc)
        return 1
    if not (text or "").strip():
        return 1
    with open(os.path.join(root, "HANDOFF.md"), "w", encoding="utf-8") as fh:
        fh.write(text.strip() + "\n")
    # Which chapter it is about, while this is still the only thing that knows.
    handoff.stamp_handoff(root, chapter_now(root))
    return 0


def check(argv):
    """Can this machine teach for nothing right now, and if not, why not.

    The question `board doctor` could never answer and the one every bad evening
    actually turns on. A board can be up, a tutor can be attached, the log can be
    empty, and the free chain can still be unable to write a word -- because a key
    file was never created, because every preferred model was retired, because
    the exit node this machine routes through is blocked by a provider. Each of
    those looks identical from the board: nothing arrives.

    So this asks for real. It walks the chain, sends one trivial completion, and
    prints what each model said, ending in a sentence in English about whether a
    lesson can happen. `--deep` also sends a picture, because handwriting is how
    most answers arrive here and a text chain that works proves nothing about it.
    """
    deep = "--deep" in argv
    print("free tutor -- what this machine can teach with")
    print()
    present = freechain.providers_present()
    for path in freechain.missing_keys():
        print("  no key   %s" % path)
    if not present:
        print()
        print("No provider key on this machine, so there is no free tutor at all.")
        print("Create one of the files above with the key in it, and rerun this.")
        return 1
    print("  keys     %s" % ", ".join(present))
    stale = freechain.dead_models()
    if stale:
        print("  retired  %s" % ", ".join(sorted(stale)))
        print("           (forget them and try again with: board free --forget)")

    chain = freechain.text_chain()
    print()
    if not chain:
        print("Every provider answered, and nothing on offer can write a card.")
        print("That is unusual enough to be worth reading: board free --list")
        return 1
    print("the chain, best first:")
    for link in chain:
        print("  %-10s %s" % (link["provider"], link["model"]))
    print()
    print("asking it to answer, in order:")
    answered = []
    try:
        reply = chat([{"role": "user",
                       "content": "Reply with exactly the word: ready"}],
                     max_tokens=CARD_LIMIT, note=lambda m: print("  " + m))
        answered.append(("text", reply.strip()[:40]))
    except RuntimeError as exc:
        print("  !! %s" % exc)

    if deep and answered:
        print()
        print("asking it to read a picture:")
        png = _eye_test()
        if not png:
            print("  !! could not render a test image (is TeX installed? board doctor)")
        else:
            got = ocr_image(png)
            ok = "42" in got and "banana" in got.lower()
            print("  %s" % (got or "(nothing)").strip().replace("\n", " ")[:200])
            print("  %s" % ("read it" if ok else
                            "!! did not read what is on the page"))
            if ok:
                answered.append(("vision", "ok"))

    print()
    if not answered:
        print("Nothing on the chain answered, so a lesson on this machine would")
        print("sit in silence. The likeliest causes, in order:")
        print("  1. no egress -- every request leaves through an exit node here.")
        print("     check it:  board egress --repair")
        print("  2. the day's free allowance on both pools is spent; it returns.")
        print("  3. the keys have expired. Replace them in ~/.config/api-keys.")
        return 1
    if deep and not any(k == "vision" for k in [a[0] for a in answered]):
        print("Cards will be written, but handwriting will not be read: the")
        print("student's page reaches the tutor as an apology instead of their")
        print("working. Rerun later -- free vision models are often busy.")
        return 1
    print("This machine can teach for nothing. A card was written by a model on")
    print("the chain above, just now.")
    return 0


def _eye_test():
    """A tiny image with two things on it nobody could guess. Returns a path or ''.

    Deliberately not a LaTeX render: this has to work on a machine where TeX is
    not installed, because whether the vision chain answers has nothing to do
    with whether this machine can typeset. A PNG written byte by byte would be
    unreadable to a model, so it is drawn as text on a page the only way the
    stdlib can -- a PBM bitmap of large block digits, converted by nothing.
    """
    import tempfile
    glyphs = {
        "4": ("#..#", "#..#", "####", "...#", "...#"),
        "2": ("####", "...#", "####", "#...", "####"),
        "B": ("###.", "#..#", "###.", "#..#", "###."),
        "A": ("####", "#..#", "####", "#..#", "#..#"),
        "N": ("#..#", "##.#", "#.##", "#..#", "#..#"),
        "Z": ("####", "...#", ".##.", "#...", "####"),
    }
    word = "BANANA 42"
    rows = ["" for _ in range(5)]
    for ch in word:
        g = glyphs.get(ch, ("....",) * 5)
        for i in range(5):
            rows[i] += g[i] + "."
    scale = 8
    w, h = len(rows[0]) * scale, 5 * scale
    pad = 4 * scale
    lines = []
    for _ in range(pad):
        lines.append("0 " * (w + 2 * pad))
    for r in rows:
        line = "0 " * pad + "".join(("1 " if c == "#" else "0 ") * scale for c in r) \
               + "0 " * pad
        for _ in range(scale):
            lines.append(line)
    for _ in range(pad):
        lines.append("0 " * (w + 2 * pad))
    fd, path = tempfile.mkstemp(prefix="free-eye-", suffix=".pbm")
    os.close(fd)
    try:
        with open(path, "w", encoding="ascii") as fh:
            fh.write("P1\n%d %d\n" % (w + 2 * pad, len(lines)))
            fh.write("\n".join(l.strip() for l in lines))
    except OSError:
        return ""
    png = path[:-4] + ".png"
    try:
        p = subprocess.run(["sips", "-s", "format", "png", path, "--out", png],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=30)
        if p.returncode == 0 and os.path.exists(png):
            return png
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        p = subprocess.run(["magick", path, png], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=30)
        if p.returncode == 0 and os.path.exists(png):
            return png
    except (OSError, subprocess.TimeoutExpired):
        pass
    return ""


def main(argv):
    if argv and argv[0] in ("--check", "check"):
        return check(argv[1:])
    if argv and argv[0] == "--handoff":
        return write_handoff(os.getcwd())
    inbox = (argv[0] if argv else "").strip()
    root = os.getcwd()

    rec = recap(root)

    ocr_parts = []
    for p in find_paths(inbox):
        abs_p = p if os.path.isabs(p) else os.path.join(root, p.lstrip("/"))
        if os.path.exists(abs_p):
            ocr_parts.append("### %s\n%s" % (p, ocr(abs_p)))

    brief = load_brief(root)

    user = (
        "The lesson so far (from `board recap`):\n\n%s\n\n" % rec +
        "The student just sent (from the inbox):\n\n%s\n\n" % (inbox or "(nothing)")
    )
    if ocr_parts:
        user += "Their handwriting / upload, OCR'd:\n\n" + "\n\n".join(ocr_parts) + "\n\n"

    system = (
        "You are a mathematics tutor on a live board. The student writes on an iPad; "
        "you never see them type and there is no chat. Each turn you write ONE card.\n\n"
        "Output ONLY the card, as markdown front matter plus the body, nothing else:\n\n"
        "---\nkind: <lesson|question|correct|wrong|review|note|recap>\n"
        "title: <a short title>\n---\n\n"
        "<the card itself, spoken to the student, in markdown with $...$ and $$...$ math>\n\n"
        "Example:\n\n"
        "---\nkind: question\ntitle: Which subfield is fixed?\n---\n\n"
        "Take $L = \\QQ(\\sqrt[3]{2}, \\omega)$ and the subgroup $H = \\gen{\\sigma}$ of "
        "order 3.\n\n"
        "Which of the three intermediate fields is $\\Fix(H)$, and why can it not be "
        "$\\QQ(\\sqrt[3]{2})$?\n\n"
        "Write the card and nothing else. Do not think out loud, do not narrate what you "
        "are about to do, and do not talk ABOUT the student -- the card is addressed TO "
        "them. If you need to work something out, do it silently.\n\n"
        "Teach only what this step needs, then pose at most ONE question and stop. A wrong "
        "answer gets its break located, not repaired; never re-explain what they already "
        "got right.\n\n"
        + (("The session brief (your compact guide):\n\n%s" % brief) if brief else "")
    )

    def unusable(reply):
        """A reply is no good as a card if it is the model thinking out loud.

        Checked on the whole reply rather than on the parsed body, because the
        shape this catches has no front matter at all -- `card_markdown` then
        hands the entire monologue back as the body, which is precisely how one
        reached the board on 1 September 2026.
        """
        kind_, title_, body_ = parse_card(reply)
        return (not body_.strip()) or looks_meta(body_) \
            or reasoning.reads_as_reasoning(body_)

    kind, title, body = "lesson", "", ""
    for attempt in range(2):
        try:
            reply = chat([{"role": "system", "content": system},
                          {"role": "user", "content": user}],
                         max_tokens=CARD_LIMIT, reject=unusable)
        except RuntimeError as exc:
            if attempt:
                sys.stderr.write("free tutor: %s\n" % exc)
                return 1
            sys.stderr.write("free tutor: %s (retrying)\n" % exc)
            continue
        kind, title, body = parse_card(reply)
        if not unusable(reply):
            break
        sys.stderr.write("free tutor: got thinking or a plan instead of a card; "
                         "correcting\n")
        user += ("\n\n(Your previous reply was not the card itself. Output ONLY the card "
                 "again, as markdown front matter plus body, with the body being the actual "
                 "teaching prose — state the mathematics directly, addressed to the student. "
                 "Do not narrate what you are doing or reason out loud.)")

    if not body:
        sys.stderr.write("free tutor produced an empty card\n")
        return 1
    # And if it is STILL deliberation after the correction, write nothing.
    #
    # The old shape of this loop tried twice and then wrote whatever it had,
    # which on 1 September put eight hundred tokens of "Hmm, wait. Let me
    # re-read the question" on the board as the lesson, cut off mid-sentence.
    # A turn that produces no card is a turn somebody waits through; a monologue
    # that becomes a card is the lesson, and there is no undo.
    if looks_meta(body) or reasoning.reads_as_reasoning(body):
        sys.stderr.write("free tutor: every model on the chain deliberated instead of "
                         "writing a card; nothing written\n")
        return 1
    args = [sys.executable, BOARD, "write", kind] + ([title] if title else [])
    p = subprocess.run(args, cwd=root, input=body.encode("utf-8"),
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=60)
    sys.stderr.write(p.stdout.decode("utf-8", "replace"))
    return p.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
