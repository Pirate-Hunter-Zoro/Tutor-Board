#!/usr/bin/env python3
"""
tutor -- start a tutoring session.

    tutor                       pick a course from what is on disk
    tutor galois                match a course by name
    tutor galois --homework     and open a homework sitting
    tutor trd --agent opencode  with a particular assistant
    tutor galois --no-agent     just bring the board up
    tutor resume                take the board over on this machine (for a login hook)
    tutor headless galois       run the assistant as a daemon, driven from the iPad
    tutor headless --stop       stop it
    tutor agent status          which course has an assistant attached
    tutor agent start galois    attach one there, detaching whatever was elsewhere
    tutor agent stop galois     ask it to write its handoff and go
    tutor where                 what is up, on this machine and on the tailnet
    tutor restart [--tutors]    restart every board here (and its tutor) on current code

One command, from anywhere. It finds the course, brings its board up, opens a
session, and launches whichever assistant you use -- already pointed at the
repository's own contract, with the board already running.

The alternative it replaces is: remember which directory, cd there, start an
agent, and then tell the agent to start the board. That last step in particular
is ceremony the person should never have to perform, and forgetting it produces
a session where the assistant is talking into a terminal nobody is reading.

Which assistant runs is configuration, not code. Nothing here knows or cares
which one it is; see `tutor --agents`.
"""

import json
import os
import re
import shutil
import subprocess
import sys

TOOL = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, TOOL)
import boardlib  # noqa: E402  -- after the path insert, which is what finds it

BOARD = os.path.join(TOOL, "bin", "board")
CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.join(os.path.expanduser("~"), ".config")),
    "tutor-board")
CONFIG = os.path.join(CONFIG_DIR, "config.json")

DEFAULT_CONFIG = {
    "courses_dir": os.path.dirname(TOOL),
    "default_agent": "claude",
    "agents": {
        # `prompt: argv`  -- the brief is passed as a final argument
        # `prompt: none`  -- the agent is launched bare and told where to read
        #
        # `headless` is how to run one turn without a terminal: a command that
        # takes a prompt, does the work, and exits. {prompt} is substituted.
        # Continuity across turns is the agent's own business -- most keep a
        # session and offer a flag to resume it, which is what belongs here.
        # The default. Claude Code is a general coding agent with the course
        # repository already in front of it, which is most of a tutor: it reads
        # the slate PNG itself rather than through a transcription model, writes
        # the card, and edits the course's own .tex when a homework sitting needs
        # it. What it costs is the ~38k-token tool prompt on every turn, which is
        # why `free` exists below and why it is still a name in this file.
        #
        # What it is allowed to do headless is NOT set here. `board start` writes
        # the course its own `.claude/settings.local.json` -- see
        # `TUTOR_PERMISSIONS` in bin/board -- because that file is committed,
        # readable by the course's owner and adjustable per course. Repeating the
        # same grant as a flag on this command would be a second source of truth
        # for one policy, and the two would drift the first time either moved.
        "claude": {
            "cmd": ["claude"], "prompt": "argv",
            # `headless_first` opens the session; `headless` continues it, so the
            # agent is not re-reading the whole contract on every single turn.
            "headless_first": ["claude", "-p", "{prompt}"],
            "headless": ["claude", "-p", "{prompt}", "--continue"],
        },
        "opencode": {
            "cmd": ["opencode"], "prompt": "argv",
            "headless_first": ["opencode", "run", "{prompt}"],
            "headless": ["opencode", "run", "--continue", "{prompt}"],
        },
        # The free tutor: a per-turn script over the free-model chain, not a
        # terminal agent. `raw_prompt` passes the inbox text through as-is rather
        # than the opencode-style instruction prompt -- the script builds its own
        # context. It is headless-only; the interactive `cmd` is opencode, so a
        # person asking for a terminal session still gets one.
        #
        # It is no longer the default and is not going anywhere: it is the tutor
        # for a machine you want to run without paying for a model, and it is
        # still selected the same way as any other -- `--agent free`, a course's
        # `tutorboard.json`, or this file's `hosts` and `default_agent`.
        "free": {
            "cmd": ["opencode"], "prompt": "argv",
            "raw_prompt": True,
            "headless_first": [sys.executable, os.path.join(TOOL, "bin", "free"), "{prompt}"],
            "headless": [sys.executable, os.path.join(TOOL, "bin", "free"), "{prompt}"],
            # The wrap-up turn writes HANDOFF.md rather than a card.
            "handoff": [sys.executable, os.path.join(TOOL, "bin", "free"), "--handoff", "{prompt}"],
        },
        "codex": {
            "cmd": ["codex"], "prompt": "argv",
            "headless": ["codex", "exec", "{prompt}"],
        },
        "aider":  {"cmd": ["aider"], "prompt": "none"},
        "cursor": {"cmd": ["cursor-agent"], "prompt": "none"},
    },
    # Which assistant a given machine prefers, keyed by its short hostname. A
    # laptop and a cluster node do not have the same tools installed and should
    # not need different configuration files to say so. Empty means every
    # machine falls through to default_agent.
    "hosts": {},
    "headless_timeout": 900,
    # How long the wrap-up turn gets. It is one turn, but it writes files.
    "handoff_timeout": 600,
    # How many turns one of the agent's own sessions is allowed to carry before
    # the next turn starts a fresh one.
    #
    # Resuming is the cheap move up to a point: it saves re-reading the contract,
    # the method and the lesson. But a resumed turn resends the entire
    # conversation as input, so the cost of every turn grows with the length of
    # the lesson -- by turn twenty the agent is paying for nineteen turns of
    # history, most of it text it will never look at again. A fresh session pays
    # the cold-start read once (contract, method, `board recap`) and then pays for
    # nothing it has forgotten, because the lesson is on disk.
    #
    # So: resume for a while, then reset. 0 disables the reset and resumes for
    # ever, which is right for a flat-rate subscription and wrong for a model
    # billed by the token.
    "session_turns": 12,
}


def load_config():
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    try:
        with open(CONFIG, "r", encoding="utf-8") as fh:
            user = json.load(fh) or {}
        for k, v in user.items():
            if k == "agents" and isinstance(v, dict):
                cfg["agents"].update(v)
            else:
                cfg[k] = v
    except (OSError, ValueError):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        if not os.path.exists(CONFIG):
            with open(CONFIG, "w", encoding="utf-8") as fh:
                json.dump(DEFAULT_CONFIG, fh, indent=2)
                fh.write("\n")
    return cfg


# ---------------------------------------------------------------------------
def read_course(root):
    cfg = {"name": os.path.basename(root).replace("-", " "), "mode": None}
    try:
        with open(os.path.join(root, "tutorboard.json"), "r", encoding="utf-8") as fh:
            cfg.update(json.load(fh) or {})
    except (OSError, ValueError):
        pass
    return cfg


def this_host():
    """What this machine calls itself. One place decides; see boardlib."""
    import boardlib
    return boardlib.node_name()


def missing_command(recipe):
    """The recipe's own executable, when this machine has not got it.

    Worth asking because the default is now a particular program rather than a
    self-contained script, and two machines do not have the same tools installed.
    An agent whose command is missing does not fail loudly: the daemon starts,
    the board shows an assistant listening, and every turn dies in a log file. Say
    it where somebody can still do something about it.

    A script agent runs under this interpreter, which is by definition present.
    """
    exe = (recipe or [None])[0]
    if not exe or os.path.basename(exe) == os.path.basename(sys.executable):
        return None
    return None if shutil.which(exe) else exe


def resolve_agent(cfg, course, override=None):
    """Which assistant tutors this course, on this machine.

    Most specific wins, and every layer is configuration rather than code:

      1. --agent on the command line          -- this once
      2. "agent" in the course's tutorboard.json -- this course, everywhere
      3. "hosts" in the config, by hostname   -- this machine, every course
      4. default_agent                        -- everything else

    Which model an assistant runs is not a layer here and never should be: an
    agent entry is a command recipe, so a second model is a second entry whose
    `cmd` carries the flag. Nothing in this file knows what a model is.
    """
    for pick in (override, (course or {}).get("agent"),
                 (cfg.get("hosts") or {}).get(this_host()),
                 cfg.get("default_agent")):
        if pick and pick in cfg["agents"]:
            return pick
        if pick:
            print("no agent called '%s'; try: tutor --agents" % pick, file=sys.stderr)
            return None
    return None


def courses(cfg):
    """Whatever is on disk. No registry, so nothing to keep in step."""
    base = os.path.expanduser(cfg["courses_dir"])
    out = []
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return out
    for name in names:
        root = os.path.join(base, name)
        if not os.path.isdir(root) or os.path.abspath(root) == TOOL:
            continue
        if not (os.path.isfile(os.path.join(root, "tutorboard.json")) or
                os.path.isfile(os.path.join(root, "AI_INSTRUCTIONS.md")) or
                os.path.isdir(os.path.join(root, "live"))):
            continue
        info = read_course(root)
        info["root"] = root
        info["dir"] = name
        out.append(info)
    return out


def pick(cands, query):
    """Match on the directory name or the declared course name, loosely."""
    if not query:
        return None
    q = re.sub(r"[^a-z0-9]", "", query.lower())
    exact = [c for c in cands if re.sub(r"[^a-z0-9]", "", c["dir"].lower()) == q]
    if exact:
        return exact[0]
    hits = [c for c in cands
            if q in re.sub(r"[^a-z0-9]", "", c["dir"].lower())
            or q in re.sub(r"[^a-z0-9]", "", (c.get("name") or "").lower())]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        print("'%s' matches more than one course:" % query, file=sys.stderr)
        for c in hits:
            print("  %s" % c["dir"], file=sys.stderr)
        sys.exit(1)
    print("no course matching '%s'. Try: tutor --list" % query, file=sys.stderr)
    sys.exit(1)


def choose(cands):
    print("Courses:\n")
    for i, c in enumerate(cands, 1):
        print("  %2d  %-26s %s" % (i, c.get("name") or c["dir"], c.get("mode") or ""))
    print()
    try:
        raw = input("which? ").strip()
    except (EOFError, KeyboardInterrupt):
        sys.exit(0)
    if raw.isdigit() and 1 <= int(raw) <= len(cands):
        return cands[int(raw) - 1]
    return pick(cands, raw)


def board(root, *args):
    p = subprocess.run([sys.executable, BOARD] + list(args), cwd=root,
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    return p.returncode, p.stdout.decode("utf-8", "replace")


def link(root):
    """Bring the tailnet link up, on every launch, before anything reads addresses.

    An allocation ending takes the daemon with it, so the first thing a new
    session needs is the link back -- and asking a person to run it themselves
    is exactly the ceremony this launcher exists to remove. Nothing is forced:
    the ownership check inside `board` clears a claim from a node that is no
    longer held, and refuses when another live node really is holding it.

    A machine with no tailscale, or one that is not logged in, is a legitimate
    outcome; the board is still up on loopback. This never fails a launch.
    """
    code, out = board(root, "vpn", "up")
    if code == 3:
        print(out.strip())              # not logged in -- the URL is the point
        return
    if code != 0:
        return
    # `board net` re-points an existing serve on its own; this is for the case
    # where there is no serve yet, which is every first link on a fresh daemon.
    code, out = board(root, "vpn", "serve")
    if code != 0:
        print(out.strip(), file=sys.stderr)


BRIEF = """# Session brief

You are tutoring in this repository. Read `AI_INSTRUCTIONS.md` in full before
anything else; it is the contract and it overrides your own defaults.

- Course: **%(name)s**
- Mode: **%(mode)s**  (math = the user answers by writing on the slate; code = there is a text box)
- Session: **%(session)s**

**The board is already running.** Do not start another one. It is at:

%(urls)s

The user is reading that page, probably on an iPad, not this terminal. Write each
teaching turn as a card in `live/cards/` and keep the terminal to a line or two.
Check `board inbox` at the start of every turn. When the session ends, run
`board finish` so the board can offer to save and push.

**Reading handwriting.** Handwriting is a PNG, a problem sheet is a PDF. If your
model can see images, open the file directly; if it cannot, call the
`describe_image` tool on the file path and read the OCR it returns.

**Read `live/TEACHING.md` before your first card.** It is the method every course
on this board is taught by, and it is not optional: pick the section's exercises
first, choose a manageable few, teach only what each one needs, pose one question,
and stop. It ships with the board rather than with the course, so it is the same
everywhere and cannot drift.

**Read `HANDOFF.md` before your first card** if the repository has one. It is
what the last session left for you: where the student got to, what they got
wrong, and what comes next. Sessions end without warning — a switched course, a
closed lid, an allocation that expired — so it is the only continuity there is.

**`board recap` is how you read the lesson, not `live/cards/` one file at a
time.** One command prints the session, every card as a line, the newest card in
full and the student's own turns. Reading a twelve-card lesson card by card is
twelve round trips for something you were handed in one, and on a model billed by
the token every one of them is charged against the whole conversation. Read what
you need once; do not re-read this brief, the contract or the method on later
turns.
"""

# Sessions do not end tidily. A course is switched on the iPad, a lid closes, an
# allocation expires. Whatever the reason, the assistant gets one last turn to
# write down where things got to, because the alternative is the next session
# opening cold and asking the student to recap their own lesson.
HANDOFF_PROMPT = (
    "This session is ending now. You get one turn and nobody will read stdout.\n\n"
    # This turn runs on the resumed session, so the lesson is already in front of
    # it. It used to be told nothing of the sort and would re-read the cards, the
    # contract and the old handoff before writing a word.
    "You have this session in your context. Do not re-read the cards, the "
    "contract, TEACHING.md or the old HANDOFF.md to write this. If the earlier "
    "part of the lesson is missing from it, `board recap` gives you the whole "
    "shape in one call.\n\n"
    "Write `HANDOFF.md` at the root of this repository -- replacing it, not "
    "appending. **Keep it under 350 words.** It is read in full at the start of "
    "every future session, so length here is a cost paid over and over, and a "
    "long one gets skimmed. Short and concrete:\n\n"
    "- where the student got to, by topic, not by card number\n"
    "- what they got wrong, and what the misunderstanding actually was\n"
    "- what they got right, so it is not re-taught\n"
    "- the single next thing to teach, and why that one\n"
    "- anything about how this student works that took you a while to learn\n\n"
    # Not a documentation review. "Fix anything that drifted" was read as an
    # invitation to re-read and rewrite two long documents on the way out of
    # every session, which is a whole turn's worth of tokens for nothing the
    # student asked for.
    "If something you wrote this session made a specific line in the course's "
    "README or AI_INSTRUCTIONS.md actually false, fix that line. Do not review "
    "either document for drift and do not rewrite sections.\n\n"
    "Do not ask questions, do not start new teaching, and do not write a card -- "
    "the student has already gone."
)


# ---------------------------------------------------------------------------
# Headless: the assistant as a daemon, driven entirely from the iPad.
#
# `board wait` blocks until the student sends something and then exits. That is
# the whole engine: wait, hand what arrived to the assistant, let it write cards,
# wait again. Nobody is at a terminal at any point.
#
# It writes a heartbeat as it goes, because a daemon you cannot see is worse than
# no daemon -- the board shows whether anything is actually listening.
# ---------------------------------------------------------------------------
import signal
import threading
import time

# Two prompts, and the difference between them is most of what a headless course
# costs. The first turn of a daemon's life has nothing in context, so it pays for
# the contract, the method and the lesson once. Every turn after it runs with the
# agent's own session resumed -- the recipe's `--continue` -- so it ALREADY holds
# all of that, and the old single prompt told it to read the lot again anyway:
# AI_INSTRUCTIONS.md, TEACHING.md, BRIEF.md, HANDOFF.md and every card in the
# lesson, one tool call each. On a model billed by the token that is not a small
# waste. Every round trip inside a turn resends the whole conversation, so a
# re-read is charged again for the rest of the turn and again for the rest of the
# session; a twelve-card lesson was paying twelve growing round trips before a
# word of teaching was written. Nothing about teaching quality needed it.
HEADLESS_FIRST_PROMPT = (
    "You are running headless: there is no terminal and nobody will read stdout. "
    "The student is on the board.\n\n"
    "Read these once, in this order: AI_INSTRUCTIONS.md (the contract for this "
    "course), live/TEACHING.md (the method -- the section's exercises first, a "
    "manageable few, teach only what each needs, one question per turn, then "
    "stop), and HANDOFF.md at the root if it exists (where the last session got "
    "to and what not to re-teach).\n\n"
    # One call instead of one per card. The lesson is a transcript and an
    # assistant resuming it needs its shape, its last card and the student's last
    # move -- not every card re-read in full.
    "Then run `board recap`. That one command prints the session, every card as a "
    "single line, the newest card in full and the student's latest turn with its "
    "file paths. Do not read live/cards/ file by file; the recap is the lesson.\n\n"
    "They just sent this:\n\n%s\n\n"
    "That text is the inbox -- it already carries every file path, so do not run "
    "`board inbox` as well; it has been marked read and will tell you nothing. "
    "Open anything the text names -- handwriting and PDFs: read them however your "
    "model sees images, opening the file directly or calling `describe_image` on "
    "the path and reading its OCR -- "
    "then reply by writing ONE new card into live/cards/. Do not write more than "
    "one card. Do not ask them to type in a terminal.\n\n"
    "Write that card FIRST, before any verifying, filing or handoff. It appears on "
    "their board the instant the file exists, so everything else you do happens "
    "while they are reading rather than while they are staring at a blank page.\n\n"
    "What you have read stays in this session for the turns that follow. You will "
    "not be asked to read it again."
)

HEADLESS_RESUME_PROMPT = (
    "Same session, next turn. Your own conversation is resumed, so you already "
    "hold the contract, the method, the handoff and every card you have written. "
    "**Do not re-read AI_INSTRUCTIONS.md, live/TEACHING.md, live/BRIEF.md, "
    "HANDOFF.md, or the cards in live/cards/.** Re-reading what is already in "
    "front of you is the most expensive thing you can do here and it teaches "
    "nothing.\n\n"
    "They just sent this:\n\n%s\n\n"
    "That text is the inbox and carries every file path, so do not run `board "
    "inbox` as well. Open what it names -- handwriting and PDFs, read however your "
    "model sees images (open directly, or `describe_image` on the path and read "
    "its OCR) -- and reply by writing ONE new "
    "card into live/cards/. Write the "
    "card FIRST; nothing else needs reading before it.\n\n"
    "Teach the way you already read: locate the break in a wrong answer rather "
    "than repairing it, one question, then stop. If you have genuinely lost the "
    "thread, `board recap` gives you the whole lesson in one call -- reading the "
    "cards one by one is never the answer."
)


def turn_plan(spec, carried, recycle):
    """Which recipe and which prompt this turn gets, and whether it is fresh.

    `carried` is how many turns the agent's current session already holds; 0
    means there is nothing to resume. `recycle` is `session_turns` from the
    config -- 0 resumes for ever.

    Resuming saves re-reading the contract, the method and the lesson. It is not
    free: a resumed turn resends the whole conversation as input, so turn twenty
    pays for nineteen turns of history. Past a point a fresh session that reads
    the contract once and the lesson back through `board recap` is cheaper than
    carrying everything, so this is where the two are traded off.
    """
    recipe = spec.get("headless")
    first = spec.get("headless_first") or recipe
    fresh = carried == 0 or bool(recycle) and carried >= recycle
    return (first if fresh else recipe,
            HEADLESS_FIRST_PROMPT if fresh else HEADLESS_RESUME_PROMPT,
            fresh)


def agent_state(live, **kw):
    path = os.path.join(live, "agent.json")
    try:
        with open(path, "r", encoding="utf-8") as fh:
            st = json.load(fh)
    except (OSError, ValueError):
        st = {}
    st.update(kw)
    st["last_seen"] = time.time()
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(st, fh, indent=2)
    os.replace(tmp, path)
    return st


def headless_stop(cfg, args):
    stopped = 0
    for c in courses(cfg):
        path = os.path.join(c["root"], "live", "agent.json")
        try:
            with open(path, "r", encoding="utf-8") as fh:
                st = json.load(fh)
        except (OSError, ValueError):
            continue
        pid = st.get("pid")
        # An interactive assistant is somebody's terminal. `headless --stop` is
        # for daemons, and killing a session a person is sitting in front of is
        # not what anyone typing it meant.
        if st.get("mode") == "interactive":
            continue
        if pid and st.get("host") == this_host():
            try:
                os.kill(pid, signal.SIGTERM)
                print("  stopped %s (pid %d)" % (c["dir"], pid))
                stopped += 1
            except OSError:
                pass
        try:
            os.remove(path)
        except OSError:
            pass
    print("stopped %d" % stopped if stopped else "nothing was listening")
    return 0


def sync(root, quiet=False):
    """Pull whatever another machine pushed, before the session starts.

    The point of the handoff is that a course can be picked up somewhere else,
    and a handoff written on the Mac mini is worth nothing to a compute node
    that never fetched it. So every session begins by catching up.

    Fast-forward only, and never fatal. A session that will not start because a
    branch diverged is worse than a session that starts a commit behind and says
    so -- the person is holding an iPad and cannot fix a merge from there.
    """
    if not os.path.isdir(os.path.join(root, ".git")):
        return None
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="/bin/false")
    def git(*args, **kw):
        return subprocess.run(["git"] + list(args), cwd=root, env=env,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              timeout=kw.get("timeout", 45))
    try:
        if git("remote", "get-url", "origin").returncode != 0:
            return None
        before = git("rev-parse", "HEAD").stdout.decode().strip()
        p = git("pull", "--ff-only", timeout=60)
        after = git("rev-parse", "HEAD").stdout.decode().strip()
    except (OSError, subprocess.TimeoutExpired):
        if not quiet:
            print("  could not reach the remote; working with what is here")
        return False
    if p.returncode != 0:
        out = p.stdout.decode("utf-8", "replace").strip().splitlines()
        if not quiet:
            print("  not synced: %s" % (out[-1] if out else "pull failed"))
            print("  the session will start anyway, on what is here")
        return False
    if before != after and not quiet:
        n = git("rev-list", "--count", "%s..%s" % (before, after)).stdout.decode().strip()
        print("  pulled %s commit(s) from another machine" % n)
    return True


def sync_transcript(root, log=None):
    """Commit and push the lesson transcript, pulling first.

    The transcript -- cards, turns, ink, answers, session state and the archive
    -- is versioned, so a lecture is the same wherever it is picked up. This runs
    on a beat while the headless tutor is alive: an allocation that dies
    mid-lesson costs one beat of work, not the evening. The pull is
    fast-forward-only and everything here is non-fatal -- a diverged branch or a
    dead remote is logged and retried next beat, never resolved by hand, because
    a transcript is append-only on one machine at a time and a merge is the last
    thing it should ever need.
    """
    if not os.path.isdir(os.path.join(root, ".git")):
        return
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="/bin/false")

    def note(line):
        if log:
            try:
                log.write(line + "\n")
            except (OSError, ValueError):
                pass

    def git(*args, **kw):
        return subprocess.run(["git"] + list(args), cwd=root, env=env,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              timeout=kw.get("timeout", 60))
    try:
        if git("remote", "get-url", "origin").returncode != 0:
            return
        p = git("pull", "--ff-only")
        if p.returncode != 0:
            out = p.stdout.decode("utf-8", "replace").strip().splitlines()
            note("transcript: not pulled (%s)" % (out[-1] if out else "pull failed"))
        git("add", "-A", "live")
        if git("diff", "--cached", "--quiet").returncode == 0:
            return
        if git("commit", "-m", "lesson transcript").returncode != 0:
            return
        # `origin HEAD` rather than a bare push, so it works whether or not the
        # clone has an upstream set for its branch.
        q = git("push", "origin", "HEAD")
        note("transcript: pushed" if q.returncode == 0 else "transcript: push failed")
    except (OSError, subprocess.TimeoutExpired):
        note("transcript: could not reach the remote")


def agent_live(root):
    """The daemon recorded for this course, if it is really there.

    A pid on a shared filesystem proves nothing -- the record may have been
    written by a node whose allocation has since ended -- so the host is checked
    before the pid is believed.
    """
    try:
        with open(os.path.join(root, "live", "agent.json"), "r", encoding="utf-8") as fh:
            st = json.load(fh)
    except (OSError, ValueError):
        return None
    import boardlib
    return st if boardlib.agent_is_attached(st, this_host()) else None


def agent_start(cfg, course, agent_name, session=None):
    """Put an assistant in this course's repository, detached.

    Detached because the thing asking is usually an HTTP request from the iPad,
    which must not wait on an agent, and because the daemon has to outlive the
    request that started it.
    """
    root = course["root"]
    live_dir = os.path.join(root, "live")
    st = agent_live(root)
    if st:
        return 0, "%s already listening in %s" % (st.get("agent"), course["dir"])
    if not agent_name:
        return 1, "no agent resolved for %s" % course["dir"]
    spec = cfg["agents"].get(agent_name) or {}
    if not spec.get("headless"):
        return 1, "'%s' has no headless recipe; add one in %s" % (agent_name, CONFIG)
    gone = missing_command(spec.get("headless"))
    if gone:
        return 1, ("'%s' needs `%s`, which is not on the path here; "
                   "try: tutor --agents" % (agent_name, gone))

    # Catch up before the assistant reads anything -- including the HANDOFF.md
    # another machine may have written at the end of the last session.
    sync(root, quiet=True)

    os.makedirs(live_dir, exist_ok=True)
    cmd = [sys.executable, os.path.realpath(__file__), "headless", course["dir"],
           "--agent", agent_name]
    if session:
        cmd.append("--" + session)
    out = open(os.path.join(live_dir, "agent.log"), "a", buffering=1)
    kw = {"cwd": root, "stdout": out, "stderr": subprocess.STDOUT,
          "stdin": subprocess.DEVNULL}
    if hasattr(os, "setsid"):
        kw["preexec_fn"] = os.setsid      # survives the terminal that spawned it
    try:
        subprocess.Popen(cmd, **kw)
    except OSError as exc:
        return 1, str(exc)
    return 0, "%s starting in %s" % (agent_name, course["dir"])


def agent_stop(course, wait=False):
    """Ask the daemon to finish. It writes the handoff on its way out.

    SIGTERM rather than a kill, because the whole point of the wrap-up turn is
    that it happens. It can take a minute; nothing here waits for it unless
    asked, since the caller is usually a person switching course.
    """
    st = agent_live(course["root"])
    if not st:
        return 0, "nothing was listening in %s" % course["dir"]
    try:
        os.kill(st["pid"], signal.SIGTERM)
    except OSError as exc:
        return 1, str(exc)
    if wait:
        for _ in range(120):
            if not agent_live(course["root"]):
                break
            time.sleep(1)
    return 0, "%s in %s is wrapping up" % (st.get("agent"), course["dir"])


def cmd_agent(cfg, args):
    """tutor agent status|start|stop [course]

    The board drives this when a course is opened or left. Each course keeps its
    own assistant: they are cheap while idle, and one that survives being left
    still has the lesson in its head when you come back.
    """
    sub = args[0] if args else "status"
    rest = [a for a in args[1:] if not a.startswith("--")]
    found = courses(cfg)

    if sub == "status":
        for c in found:
            st = agent_live(c["root"])
            print("  %-26s %s" % (c.get("name") or c["dir"],
                                  ("%s (%s, %d turn(s))"
                                   % (st.get("agent"), st.get("state"), st.get("turns", 0)))
                                  if st else "-"))
        return 0

    if not rest:
        print("which course? try: tutor agent %s <name>" % sub, file=sys.stderr)
        return 1
    course = pick(found, rest[0])

    if sub == "stop":
        code, msg = agent_stop(course, wait="--wait" in args)
        print(msg, file=sys.stderr if code else sys.stdout)
        return code

    if sub == "start":
        # An assistant per course, not one per machine. Switching used to stop
        # whatever was listening elsewhere, so coming back to a course meant a
        # cold agent that had to re-read the contract, the method and the lesson
        # before it could write a word. A listening daemon is blocked on `board
        # wait` and costs nothing while nobody is asking it anything, so there is
        # no reason to make attention exclusive. They still write their handoff
        # when they are actually stopped.
        name = resolve_agent(cfg, course, _flag(args, "--agent"))
        code, msg = agent_start(cfg, course, name)
        print(msg, file=sys.stderr if code else sys.stdout)
        return code

    print("unknown: tutor agent %s" % sub, file=sys.stderr)
    return 1


def _flag(args, name):
    for n, a in enumerate(args):
        if a == name and n + 1 < len(args):
            return args[n + 1]
    return None


def headless(cfg, course, agent_name, session):
    spec = cfg["agents"].get(agent_name) or {}
    recipe = spec.get("headless")
    if not recipe:
        print("'%s' has no headless recipe in %s.\n"
              "Add one: a command that takes a prompt, does the work, and exits."
              % (agent_name, CONFIG), file=sys.stderr)
        return 1
    gone = missing_command(recipe)
    if gone:
        print("'%s' needs `%s`, which is not on the path on %s.\n"
              "Install it, or name another in %s -- `tutor --agents` lists what "
              "this machine can actually run."
              % (agent_name, gone, this_host(), CONFIG),
              file=sys.stderr)
        return 1

    root = course["root"]
    live = os.path.join(root, "live")
    os.makedirs(live, exist_ok=True)
    log = open(os.path.join(live, "agent.log"), "a", buffering=1)
    host = this_host()

    board(root, "start")
    link(root)
    if session:
        board(root, "open", course.get("name") or course["dir"], "session", "--" + session)
    _, net = board(root, "net")
    urls = "\n".join("  " + l.strip() for l in net.splitlines() if l.strip().startswith("http"))
    with open(os.path.join(live, "BRIEF.md"), "w", encoding="utf-8") as fh:
        fh.write(BRIEF % {"name": course.get("name") or course["dir"],
                          "mode": course.get("mode") or "unknown",
                          "session": session or "lecture", "urls": urls})

    agent_state(live, host=host, agent=agent_name, pid=os.getpid(),
                started=time.time(), state="listening", turns=0, last_error=None)
    print(net.rstrip())
    print("\n%s is listening in %s. Send from the board; nothing here needs a keyboard."
          % (agent_name, course["dir"]))
    print("stop with: tutor headless --stop\n")

    running = {"go": True, "waiter": None}

    def bye(*_):
        running["go"] = False
        # Kill the blocking `board wait` too, or shutting down takes as long as
        # its timeout -- five minutes of a course that has already been left.
        w = running["waiter"]
        if w and w.poll() is None:
            try:
                w.terminate()
            except OSError:
                pass
    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)

    def beat_transcript():
        # The transcript is versioned so a lesson survives the host it was taught
        # on. Push it on a beat -- pulling first, so whichever machine is active
        # stays caught up with the other. This is what makes a course read the
        # same on the compute node and the Mac mini without anyone remembering to
        # push, and it is what makes an allocation dying mid-lesson cost one beat
        # of work rather than the evening.
        while running["go"]:
            sync_transcript(root, log)
            end = time.time() + 90
            while running["go"] and time.time() < end:
                time.sleep(1)
    threading.Thread(target=beat_transcript, daemon=True).start()

    turns = 0
    carried = 0          # turns the agent's current session is carrying
    # An inbox whose turn failed for a reason that has since been repaired. The
    # student sent something and got nothing back; `board wait` will not hand it
    # over twice, so it is carried here rather than waiting for them to give up
    # and send again.
    pending = None
    recycle = int(cfg.get("session_turns", 12) or 0)
    while running["go"]:
        if pending is not None:
            out, pending = pending, None
            log.write("-- answering the message whose turn failed before\n")
        else:
            running["waiter"] = subprocess.Popen(
                [sys.executable, BOARD, "wait", "--timeout", "300"], cwd=root,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            raw = running["waiter"].communicate()[0]
            code = running["waiter"].returncode
            out = raw.decode("utf-8", "replace")
            running["waiter"] = None
            if not running["go"]:
                break
            if code != 0:
                agent_state(live, state="listening")     # timed out; still alive
                continue

        turns += 1
        agent_state(live, state="working", turns=turns)
        log.write("\n=== %s turn %d ===\n%s\n" % (time.strftime("%H:%M:%S"), turns, out))

        # Keep saying so while the turn runs. The heartbeat used to be written
        # only at these boundaries, so a turn that took longer than the board's
        # two-minute window -- which a turn that reads a chapter and writes a
        # card routinely does -- showed on the iPad as "assistant not
        # responding" while the assistant was in the middle of teaching.
        beating = threading.Event()

        def beat():
            while not beating.wait(30.0):
                agent_state(live, state="working", turns=turns)

        ticker = threading.Thread(target=beat, daemon=True)
        ticker.start()

        # The first turn of a session has no conversation to continue, and a
        # resume flag against nothing is an immediate failure. After that the
        # agent's own session is worth keeping: without it every turn pays for
        # re-reading the contract, the method and the lesson before it can write
        # a word, which is most of what a turn costs.
        # A fresh session when there is nothing to resume, and again once the
        # one we have has carried enough turns to be more expensive than
        # starting over. Everything a fresh session needs is on disk: the
        # contract, the method, and `board recap` for the lesson.
        first = spec.get("headless_first") or recipe
        use, template, fresh = turn_plan(spec, carried, recycle)
        if fresh and carried:
            log.write("-- starting a fresh session after %d turn(s); the lesson "
                      "is read back with `board recap`\n" % carried)
        # A script agent (the free tutor) builds its own context, so it gets the
        # raw inbox rather than the instruction prompt the interactive agents
        # expect -- its whole state is on disk and it re-reads what it needs.
        prompt = out.strip() if spec.get("raw_prompt") else template % out.strip()
        cmd = [a.replace("{prompt}", prompt) for a in use]
        try:
            p = subprocess.run(cmd, cwd=root, stdout=log, stderr=subprocess.STDOUT,
                               timeout=cfg.get("headless_timeout", 900))
            err = None if p.returncode == 0 else "exit %d" % p.returncode
            # A resume that finds nothing to resume is not a broken turn; it is a
            # first turn wearing the wrong recipe. Try it once as one.
            if err and use is not first:
                # A fresh session holds nothing, so the resume prompt -- which
                # says "you already have the contract, the method and the lesson"
                # -- would produce a card written against no contract at all.
                # Retry as what it actually is: a first turn.
                log.write("!! resume failed, retrying as a fresh turn\n")
                cmd = [a.replace("{prompt}", HEADLESS_FIRST_PROMPT % out.strip())
                       for a in first]
                p = subprocess.run(cmd, cwd=root, stdout=log, stderr=subprocess.STDOUT,
                                   timeout=cfg.get("headless_timeout", 900))
                err = None if p.returncode == 0 else "exit %d" % p.returncode
                fresh = True
        except subprocess.TimeoutExpired:
            err = "timed out"
        except OSError as exc:
            err = str(exc)
        finally:
            beating.set()

        if err:
            log.write("!! %s\n" % err)
            # A failed turn has two very different causes and they need telling
            # apart. The model refusing, or the agent falling over, is nothing
            # this can fix. The machine being unable to reach the provider at all
            # is -- and on a host routing everything through an exit node it is
            # the likelier one, because commercial VPN egress is exactly what a
            # provider geo-blocks or challenges. The symptom is identical from
            # here: a turn that failed. So ask the network, rather than guess.
            #
            # Only when a turn has actually failed. Probing on every turn would
            # add a round trip to the internet to every card the student waits
            # for, to answer a question that is almost always yes.
            if not boardlib.egress_ok():
                log.write("!! nothing can get out from here; the turn may not be "
                          "the tutor's fault\n")
                agent_state(live, state="listening", last_error="no egress")
                fixed, detail = boardlib.rotate_exit_node(
                    log=lambda m: log.write("   %s\n" % m))
                if fixed:
                    log.write("-- egress repaired via %s; retrying the turn\n" % detail)
                    # The student sent something and got nothing. Put the same
                    # inbox back so the next pass answers it rather than waiting
                    # for them to send again.
                    pending = out
                else:
                    log.write("!! egress still broken (%s); turns will keep "
                              "failing until the network is fixed\n" % detail)
            agent_state(live, state="listening", last_error=err)
        else:
            carried = 1 if fresh else carried + 1
            agent_state(live, state="listening", last_error=None)

    # The last turn, and the only one the student never sees.
    if turns:
        agent_state(live, state="wrapping up")
        log.write("\n=== %s handoff ===\n" % time.strftime("%H:%M:%S"))
        # A script agent may have its own way to write the handoff; default to the
        # ordinary turn recipe otherwise.
        wrap = spec.get("handoff") or recipe
        cmd = [a.replace("{prompt}", HANDOFF_PROMPT) for a in wrap]
        try:
            subprocess.run(cmd, cwd=root, stdout=log, stderr=subprocess.STDOUT,
                           timeout=cfg.get("handoff_timeout", 600))
            wrote = os.path.isfile(os.path.join(root, "HANDOFF.md"))
            log.write("handoff written\n" if wrote else "!! no HANDOFF.md was written\n")
        except (subprocess.TimeoutExpired, OSError) as exc:
            log.write("!! handoff failed: %s\n" % exc)

    agent_state(live, state="stopped")
    try:
        os.remove(os.path.join(live, "agent.json"))
    except OSError:
        pass
    print("stopped after %d turn(s)" % turns)
    return 0


def cmd_restart(cfg, args):
    """Restart every board running on this machine, on the current code.

    A board is a long-lived process that read `serve.py` when it started, so a
    change to this tool reaches a course only when its board comes back. That is
    invisible from the outside: the pages are served from disk and look new while
    the endpoints behind them are still the old ones, which is exactly the sort of
    difference somebody spends an evening not finding.

    Only boards that are actually answering on this node are touched -- a record
    on a shared filesystem may belong to another machine, and stopping a stranger's
    process is worse than leaving a stale one.
    """
    import boardlib
    host = this_host()
    touched, skipped = [], []
    for c in courses(cfg):
        live = os.path.join(c["root"], "live")
        try:
            with open(os.path.join(live, ".board.json"), "r", encoding="utf-8") as fh:
                info = json.load(fh)
        except (OSError, ValueError):
            continue
        if info.get("node") and info["node"] != host:
            skipped.append("%s (on %s)" % (c["dir"], info["node"]))
            continue
        if not boardlib.board_is_running(info.get("pid"), c["root"]):
            continue
        board(c["root"], "stop")
        code, out = board(c["root"], "start")
        if code == 0:
            touched.append(c["dir"])
        else:
            skipped.append("%s (%s)" % (c["dir"], out.strip().splitlines()[-1:] or "failed"))

    if touched:
        print("restarted: %s" % ", ".join(touched))
    else:
        print("no boards were running on %s" % host)
    for s2 in skipped:
        print("  left alone: %s" % s2)

    if "--tutors" not in args:
        return 0

    # The daemons hold old code for exactly the same reason the boards do: this
    # file is read once, when the process starts. A tutor in the middle of a turn
    # is left alone -- bouncing it loses the card it is writing, and the student
    # is the one who pays for that.
    import signal as _sig
    bounced, held = [], []
    for c in courses(cfg):
        st = agent_live(c["root"])
        if not st or st.get("mode") == "interactive":
            continue
        if st.get("state") == "working":
            held.append("%s (mid-turn)" % c["dir"])
            continue
        # What configuration says NOW, not what happened to be running. A restart
        # used to bring back whatever the record named, which meant changing
        # `default_agent` never reached a course whose tutor was restarted rather
        # than stopped -- the config said one thing and the board ran another, for
        # ever. This is the safe moment to act on it: the daemon is being stopped
        # anyway, and the SIGTERM below makes it write HANDOFF.md, which is
        # precisely the continuity a different tutor picks up from.
        was_name = st.get("agent")
        name = resolve_agent(cfg, c) or was_name
        was = st.get("pid")
        try:
            os.kill(was, _sig.SIGTERM)
        except OSError:
            pass
        # The wrap-up turn a SIGTERM starts writes HANDOFF.md, and the next tutor
        # reads it -- so waiting for the record to clear is waiting for the
        # continuity to be written, not merely for a process to die. It is one
        # turn, and a turn can take minutes, so this does not wait for ever.
        gone = False
        for _ in range(90):
            if not agent_live(c["root"]):
                gone = True
                break
            time.sleep(1.0)
        if not gone:
            # `agent_start` answers "already listening" here and answers it with
            # a success code, which is how this came to report a restart it had
            # not performed. Say what actually happened.
            held.append("%s (still writing its handoff; run this again in a"
                        " minute)" % c["dir"])
            continue
        code, msg = agent_start(cfg, c, name)
        now = agent_live(c["root"]) or {}
        if code == 0 and now.get("pid") and now["pid"] != was:
            bounced.append(c["dir"] if name == was_name
                           else "%s (%s -> %s)" % (c["dir"], was_name, name))
        else:
            held.append("%s (%s)" % (c["dir"], msg.strip() or "did not come back"))

    if bounced:
        print("tutors restarted: %s" % ", ".join(bounced))
    elif not held:
        print("no tutors were attached on %s" % host)
    for h in held:
        print("  left alone: %s" % h)
    return 0


# What "you were working here" looks like on disk. Several signals, because no
# single one survives everything:
#
#   .board.json  a board is running, or was killed without being stopped --
#                but `board stop` DELETES it, so a cleanly stopped course has
#                none at all;
#   state.json   the session: course, chapter, kind. Written by `board open`
#                and updated through the sitting, and never removed;
#   turns.jsonl  the student's own contributions, appended as they answer;
#   cards        the tutor's, written as it teaches.
#
# Taking the newest of these was the fix for a real mistake: the first version
# looked only at `.board.json`, so stopping the board you were using made that
# course invisible and the next login resumed a DIFFERENT one -- quietly, since
# a login hook runs with --quiet, and the tailnet name moved with it.
LIVE_SIGNS = (".board.json", "state.json", "turns.jsonl", "cards")


def last_used(root):
    """When this course was last worked in, as far as disk can say. 0 if never."""
    best = 0
    for rel in LIVE_SIGNS:
        try:
            best = max(best, os.path.getmtime(os.path.join(root, "live", rel)))
        except OSError:
            continue
    return best




def remember_course(course):
    """Note that a PERSON chose this course, and when.

    Not a registry: courses are still whatever directories are sitting there.
    This records a *decision*, which is a different thing and cannot be derived
    from the filesystem -- because resuming a course touches its files too, so
    "most recently used" is self-reinforcing. A hook that resumed the wrong
    course once would go on resuming it for ever, quietly, taking the tailnet
    name with it every time. Naming one is how you say otherwise.
    """
    import boardlib
    boardlib.remember_chosen(course["dir"], course["root"])


def chosen_course(cfg):
    """(when, course) for the last course a person named, if it still exists."""
    import boardlib
    rec = boardlib.chosen_course()
    if not rec:
        return None
    for c in courses(cfg):
        if c["root"] == rec.get("root") or c["dir"] == rec.get("dir"):
            return (rec.get("at") or 0, c)
    return None                   # named once, since deleted or renamed


def last_board(cfg):
    """The course to bring back.

    Two signals, and the newer one wins: when a person last named a course, and
    when a course was last worked in. Neither alone is enough -- a name given a
    week ago should not beat an afternoon spent in another course, and file times
    alone cannot tell a course you chose from one a login hook happened to
    start.
    """
    best = chosen_course(cfg)
    for c in courses(cfg):
        when = last_used(c["root"])
        if when and (not best or when > best[0]):
            best = (when, c)
    return best[1] if best else None


def board_record(root):
    try:
        with open(os.path.join(root, "live", ".board.json"), "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def prune_dead_records(cfg, host):
    """Drop `live/.board.json` for boards on nodes that are gone.

    Only for nodes Slurm can positively say are no longer yours. No Slurm at all
    means unknown, and unknown is left exactly where it is -- deleting a record
    for a board that is in fact answering would leave a live process nothing can
    find. Returns the courses it swept, for the caller to report.
    """
    import boardlib
    held = boardlib.slurm_nodes()
    if held is None:
        return []
    swept = []
    for c in courses(cfg):
        info = board_record(c["root"]) or {}
        on = info.get("node")
        if not on or on == host or on in held:
            continue
        try:
            os.remove(os.path.join(c["root"], "live", ".board.json"))
            swept.append(c["dir"])
        except OSError:
            pass
    return swept


def cmd_resume(cfg, args):
    """Take the board over on this machine. Safe to run from a login hook.

    Nothing on a compute node outlives its allocation -- not the board, not the
    tutor, not `tailscaled` itself -- so arriving on a new node means the tailnet
    name points at a machine that no longer exists and the iPad gets nothing.
    There is no way for a node to be asked to take over, because being asked
    requires something already listening, and the thing that was listening is
    what died. The only moment a compute node can act on is the moment you log
    in to it, which is what this is for.

    It is deliberately dull: quiet when there is nothing to do, quick when there
    is nothing to do, and it never takes a board away from a machine that is
    still alive unless told to.
    """
    quiet = "--quiet" in args
    force = "--force" in args
    rest = [a for a in args if not a.startswith("-")]
    host = this_host()

    def say(msg):
        if not quiet:
            print(msg)

    # Records left behind by nodes that no longer exist make the hub lie: it
    # cannot tell a board that died with an allocation from one that is
    # answering, so a course reads as "live on compute304" days after compute304
    # stopped being a machine you had, and a tap goes where nothing is
    # listening. Logging in is the moment to sweep them, because it is the
    # moment we can find out which nodes are real. Before choosing a course,
    # since a record is one of the things that decides.
    swept = prune_dead_records(cfg, host)
    if swept:
        say("cleared a dead board record for: %s" % ", ".join(swept))

    found = courses(cfg)
    course = pick(found, rest[0]) if rest else last_board(cfg)
    if not course:
        say("no board has ever run in %s; start one with: tutor" % cfg["courses_dir"])
        return 0

    if rest:
        remember_course(course)        # named on the command line: a decision

    root = course["root"]
    info = board_record(root) or {}
    on = info.get("node")

    # Catch up before anything else, on every resume and not only the one that
    # starts a fresh board: a handoff or a pushed chapter written on the machine
    # you just left is the whole point of writing it down, and the always-on
    # host's periodic resume is what keeps its warm board from going stale.
    # Fast-forward only and never fatal, so it is cheap to run on a timer.
    sync(root, quiet=True)

    import boardlib
    if on == host and boardlib.board_is_running(info.get("pid"), root):
        # Already serving here. The one thing worth checking is that the tailnet
        # name still points at this port, since that is the part a second board
        # on this node moves out from under it.
        link(root)
        started = ensure_agent(cfg, course, args, say)
        say("%s is already up here%s" % (course["dir"], started))
        return 0

    if on and on != host and not force:
        # The always-on host is the exception, and deliberately: a course cloned
        # here is taught here. It does not share a filesystem with the compute
        # node, so a record naming that node is not something this machine can
        # check at all -- and deferring to one would leave the machine that holds
        # the repository and never sleeps permanently unable to host it. Bringing
        # a board up here does not stop the other one; the proxy asks it to hand
        # its tutor over as the address moves, which is the other half of this.
        if boardlib.machine_shape() == "always-on host":
            say("%s is recorded on %s; this machine holds the repository, so it "
                "comes up here" % (course["dir"], on))
        else:
            # A record from another node proves nothing on a shared filesystem, so
            # ask Slurm whether that machine is still a machine you hold. Unknown --
            # no squeue at all -- is not the same as gone, and is left alone.
            nodes = boardlib.slurm_nodes()
            if nodes is None or on in nodes:
                say("%s is on %s, which is still yours; leaving it there "
                    "(--force to move it here)" % (course["dir"], on))
                return 0

    # Not every machine you log in to is a machine you should start a board on.
    # A login node is shared, is not yours, and is where long-running processes
    # go to be killed -- and this runs from a login hook, so it will be invited
    # to try. Slurm knows which nodes are actually yours; if there is no Slurm at
    # all this is not a cluster and the question does not arise.
    mine = boardlib.slurm_nodes()
    if mine is not None and host not in mine and not force:
        say("%s is not one of your allocations; not starting a board here" % host)
        return 0

    code, out = board(root, "start")
    if code != 0:
        say(out.strip() or "could not start the board")
        return 1
    link(root)
    started = ensure_agent(cfg, course, args, say)
    _, net = board(root, "net")
    for line in net.splitlines():
        if "ts.net/" in line and "https" in line:
            say("%s is up here, at %s%s" % (course["dir"], line.strip().split()[0], started))
            break
    else:
        say("%s is up here%s" % (course["dir"], started))
    return 0


def ensure_agent(cfg, course, args, say):
    """Attach a tutor unless told not to. Returns a clause for the caller's line."""
    if "--no-agent" in args:
        return ""
    if agent_live(course["root"]):
        return ", tutor already attached"
    name = resolve_agent(cfg, course, _flag(args, "--agent"))
    code, msg = agent_start(cfg, course, name)
    return (", %s attached" % name) if code == 0 else (", no tutor (%s)" % msg)


def cmd_where(cfg, args):
    """What is up, and whether anything is listening."""
    host = this_host()
    print("this machine: %s\n" % host)
    any_up = False
    for c in courses(cfg):
        live = os.path.join(c["root"], "live")
        board_up, on, agent = "-", "", "-"
        try:
            with open(os.path.join(live, ".board.json"), "r", encoding="utf-8") as fh:
                info = json.load(fh)
            on = info.get("node") or "?"
            if on == host:
                import boardlib
                if boardlib.board_is_running(info.get("pid"), c["root"]):
                    board_up = "up :%s" % info.get("port", "?")
                    any_up = True
                else:
                    board_up = "down"
            else:
                board_up = "on " + on
        except (OSError, ValueError):
            pass
        try:
            with open(os.path.join(live, "agent.json"), "r", encoding="utf-8") as fh:
                st = json.load(fh)
            import boardlib
            agent = ("%s %s" % (st.get("agent"), st.get("state"))) \
                if boardlib.agent_is_attached(st, host) else "stale"
        except (OSError, ValueError):
            pass
        print("  %-24s board:%-10s agent:%s" % (c.get("name") or c["dir"], board_up, agent))
    if any_up:
        print()
        for c in courses(cfg):
            _, net = board(c["root"], "net")
            for l in net.splitlines():
                if "ts.net/" in l and "https" in l:
                    print("  reachable at %s" % l.strip().split()[0])
                    break
            break
    return 0


def main(argv):
    cfg = load_config()
    args, flags = [], {"session": None, "agent": None, "no_agent": False}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        elif a in ("--list", "-l"):
            for c in courses(cfg):
                print("  %-26s %-6s %s" % (c.get("name") or c["dir"],
                                           c.get("mode") or "", c["dir"]))
            return 0
        elif a == "--agents":
            print("config: %s\n" % CONFIG)
            for n, spec in sorted(cfg["agents"].items()):
                mark = "*" if n == cfg["default_agent"] else " "
                gone = missing_command(spec.get("cmd"))
                print(" %s %-10s %-28s %s"
                      % (mark, n, " ".join(spec.get("cmd", [])),
                         "not installed here" if gone else ""))
            print("\n* is the default. Edit the config to add your own.")
            return 0
        elif a == "--homework":
            flags["session"] = "homework"
        elif a == "--lecture":
            flags["session"] = "lecture"
        elif a == "--no-agent":
            flags["no_agent"] = True
        elif a == "--stop":
            pass
        elif a == "--agent":
            i += 1
            flags["agent"] = argv[i]
        else:
            args.append(a)
        i += 1

    if args and args[0] in ("restart", "restart-boards"):
        return cmd_restart(cfg, args[1:])

    if args and args[0] == "where":
        return cmd_where(cfg, args[1:])

    if args and args[0] == "resume":
        return cmd_resume(cfg, argv[argv.index("resume") + 1:])

    if args and args[0] == "agent":
        return cmd_agent(cfg, argv[argv.index("agent") + 1:])

    if args and args[0] == "headless":
        rest = args[1:]
        if "--stop" in argv:
            return headless_stop(cfg, rest)
        found = courses(cfg)
        course = pick(found, rest[0]) if rest else choose(found)
        remember_course(course)
        return headless(cfg, course, resolve_agent(cfg, course, flags["agent"]),
                        flags["session"])

    found = courses(cfg)
    if not found:
        print("no courses under %s" % cfg["courses_dir"], file=sys.stderr)
        return 1
    course = pick(found, args[0]) if args else choose(found)
    remember_course(course)

    # --- catch up ----------------------------------------------------------
    print("\n%s" % (course.get("name") or course["dir"]))
    sync(course["root"])

    # --- the board ---------------------------------------------------------
    code, out = board(course["root"], "start")
    if code != 0:
        print(out.strip(), file=sys.stderr)
        return 1
    link(course["root"])
    if flags["session"]:
        title = " ".join(args[1:]) or "session"
        board(course["root"], "open", course.get("name") or course["dir"], title,
              "--" + flags["session"])
    _, net = board(course["root"], "net")
    urls = "\n".join("  " + l.strip() for l in net.splitlines()
                     if l.strip().startswith("http"))

    print("%s — %s" % (course.get("name") or course["dir"], course.get("mode") or "?"))
    print(net.rstrip())

    live = os.path.join(course["root"], "live")
    os.makedirs(live, exist_ok=True)
    brief = BRIEF % {
        "name": course.get("name") or course["dir"],
        "mode": course.get("mode") or "unknown",
        "session": flags["session"] or "lecture",
        "urls": urls or "  (run: board net)",
    }
    with open(os.path.join(live, "BRIEF.md"), "w", encoding="utf-8") as fh:
        fh.write(brief)

    if flags["no_agent"]:
        return 0

    # --- the assistant -----------------------------------------------------
    name = resolve_agent(cfg, course, flags["agent"])
    spec = cfg["agents"].get(name) if name else None
    if not spec:
        print("\nno assistant resolved for %s. Try: tutor --agents" % course["dir"],
              file=sys.stderr)
        return 1

    cmd = list(spec.get("cmd", []))
    opener = ("Read AI_INSTRUCTIONS.md, live/BRIEF.md and live/TEACHING.md, then run "
              "`board recap` for the lesson so far and begin. The board is already "
              "running; do not start another.")
    if spec.get("prompt") == "argv":
        cmd.append(opener)
    else:
        print("\n  then tell it:  %s" % opener)

    print("\nstarting %s in %s\n" % (name, course["dir"]))
    # Say on the board that somebody is attached. `execvp` replaces this process
    # with the assistant, so this pid is about to BE the assistant -- which is
    # what makes the record checkable later without a heartbeat. An interactive
    # session is idle whenever the person is thinking, and a heartbeat would call
    # that dead; the process either exists or it does not.
    agent_state(live, host=this_host(), agent=name, pid=os.getpid(),
                mode="interactive", cmd=cmd[0], state="attached",
                started=time.time(), turns=0, last_error=None)
    try:
        os.chdir(course["root"])
        os.execvp(cmd[0], cmd)          # hand the terminal over entirely
    except OSError as exc:
        print("could not start %s: %s" % (name, exc), file=sys.stderr)
        print("check `tutor --agents`, or edit %s" % CONFIG, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
