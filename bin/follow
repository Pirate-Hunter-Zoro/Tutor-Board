#!/usr/bin/env python3
"""
follow -- the always-on host's proxy, so the one address the iPad holds serves
whichever machine has the board.

`tailscale serve` cannot proxy to a remote node: it accepts the command and then
answers every request with a 502. So the always-on Mac runs this small proxy
locally and points `tailscale serve` at it. The proxy forwards each connection to
whichever machine is serving. A follower thread probes both and flips the target;
nothing else moves.

Which one is preferred is `follow.prefer`, and it is "local": **a course cloned
on this machine is taught on this machine.** The compute node is where the data
and the hardware are, which is why it used to win, but once the tutor is a
model reached over the network rather than something that needs the node's GPUs,
the machine that is always awake and holds the repository is the better host --
and the node is then only needed for a course this machine has not got. Set it
to "node" for the original arrangement.

Preference only settles a tie. A live board always beats a dead one, in either
direction: handing the iPad an address with nothing listening on it is worse
than serving from the machine that was not preferred.

Nor is it a tie when a machine has run out of allowance. A board whose tutor has
been told it has no quota left is still answering, still healthy, and still
unable to teach, so it loses the preference to a machine that can -- and gets it
straight back the moment the allowance returns, or when nothing else is up. That
gives one order, best first, each step taken only when the one above it cannot be:

    this machine on the paid tutor  ->  the compute node  ->  this machine on
    whatever it can run for free

The last step is the tutor's own doing rather than the proxy's: when both
machines are exhausted the address stays here, and the tutor here has by then
fallen back to the free agent. See `fallback_agent` in bin/tutor.

Which machine serves is decided by a probe, not by a record: `http://<node>:<port>/health`
answers with the repository root for a board that is genuinely up, and the port
is a fixed function of the course directory name, so the same course has the same
port on every machine. The Mac does not share the compute node's filesystem and
cannot read its records, which is exactly why the probe exists.

Config, in ~/.config/tutor-board/config.json:

    "follow": {
        "node": "board",          the compute node's tailnet name to probe
        "listen": "127.0.0.1:8844",
        "prefer": "local"         "local" (this machine) or "node"
    }
"""

import json
import os
import re
import socket
import socketserver
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request

TOOL = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, TOOL)
import boardlib  # noqa: E402

CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.join(os.path.expanduser("~"), ".config")),
    "tutor-board")
CONFIG = os.path.join(CONFIG_DIR, "config.json")

# What "you were working here" looks like on disk, newest of which wins. Mirrors
# bin/tutor's LIVE_SIGNS; the board record is the live one, the rest survive a
# clean stop.
LIVE_SIGNS = (".board.json", "state.json", "turns.jsonl", "cards")


def load_config():
    cfg = {"courses_dir": os.path.dirname(TOOL)}
    try:
        with open(CONFIG, "r", encoding="utf-8") as fh:
            cfg.update(json.load(fh) or {})
    except (OSError, ValueError):
        pass
    return cfg


def courses(cfg):
    base = os.path.expanduser(cfg.get("courses_dir") or os.path.dirname(TOOL))
    out = []
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return out
    for name in names:
        root = os.path.join(base, name)
        if not os.path.isdir(root) or os.path.abspath(root) == TOOL:
            continue
        if not (os.path.isfile(os.path.join(root, "tutorboard.json")) or
                os.path.isfile(os.path.join(root, "AI_INSTRUCTIONS.md")) or
                os.path.isdir(os.path.join(root, "live"))):
            continue
        out.append({"dir": name, "root": root})
    return out


def default_port(root):
    """Stable per-repository port, identical to bin/board's."""
    return boardlib.default_port(os.path.basename(root))


def local_port(c):
    """Where this course is serving on THIS machine.

    Its own board record first: a board whose usual port was taken starts on the
    next one in its sequence, and the record is the only place that number exists.
    The derived port is the answer when no board has run here yet.
    """
    try:
        with open(os.path.join(c["root"], "live", ".board.json"), "r",
                  encoding="utf-8") as fh:
            port = (json.load(fh) or {}).get("port")
            if port:
                return int(port)
    except (OSError, ValueError, TypeError):
        pass
    return default_port(c["root"])


def last_used(root):
    best = 0
    for rel in LIVE_SIGNS:
        try:
            best = max(best, os.path.getmtime(os.path.join(root, "live", rel)))
        except OSError:
            continue
    return best


def active_course(cands):
    """The course to serve locally when the node is down: last named, else last
    worked. Reuses the same two signals as `tutor resume`."""
    best = None
    rec = boardlib.chosen_course()
    for c in cands:
        if c["root"] == rec.get("root") or c["dir"] == rec.get("dir"):
            best = (rec.get("at") or 0, c)
    for c in cands:
        when = last_used(c["root"])
        if when and (not best or when > best[0]):
            best = (when, c)
    return best[1] if best else (cands[0] if cands else None)


def probe(host, port, timeout=2.0):
    """What is answering on this host:port, or None. /health is the honest test.

    Returns the parsed health document rather than a yes/no, because both of the
    things this proxy has to decide are in it: which course this board is (`dir`),
    and which course the person actually asked for (`chosen`).
    """
    # One implementation, in boardlib, because there are two ways to ask and
    # which one works depends on the machine: an ordinary socket where tailscale
    # has a real interface, and the SOCKS proxy on a machine running tailscaled
    # in userspace mode, which cannot open a tailnet connection any other way.
    # This file used to do it the first way only, so on such a machine every
    # question about the other side answered "nobody is there".
    return boardlib.board_health(host, port, timeout=timeout)


def identifies_as(health, name):
    """Is this board really the course we went looking for?

    Ports are derived from names, and derivation is not proof: a hash can put two
    courses on one number, and a start that found its port busy moves to the next
    one in its sequence. Asking the board who it is costs nothing and turns a
    silent wrong lesson into a miss.
    """
    if not health:
        return False
    who = health.get("dir") or os.path.basename(health.get("root") or "")
    return who == name


def has_tutor(host, port, timeout=2.0):
    """Is there an assistant attached to the board answering here?

    Between a board with a tutor listening and a board with nobody behind it
    there is no contest, and until 1 September 2026 there was no rule about it:
    a tap in a hub started a board for the chosen course on whichever machine
    served the hub, so a course could be up on both -- one of them teaching, the
    other an empty room with the same name. Preference alone then decided, and
    preference does not know which one anybody is in.
    """
    health = probe(host, port, timeout=timeout)
    return bool(health and health.get("tutor"))


def limited(host, port, timeout=2.0):
    """Has this machine's tutor been told its allowance has run out?

    Asked of the board rather than of the filesystem, because for the compute
    node there is no filesystem to ask -- the limit is written on the machine
    that hit it, and /health is the only way across. A board that does not
    publish the field at all is an older one, and an older one is not limited.
    """
    health = probe(host, port, timeout=timeout)
    if not health:
        return False
    try:
        return float(health.get("limited") or 0) > time.time()
    except (TypeError, ValueError):
        return False


def find_course(node, c, timeout=2.0):
    """The port this one course is answering on, or None.

    Walks the same port sequence `board start` walks, so a board that had to move
    off its usual number is still found -- and confirms identity at each step, so
    a course sitting on somebody else's number is not mistaken for them.
    """
    for port in boardlib.port_sequence(c["dir"]):
        health = probe(node, port, timeout=timeout)
        if identifies_as(health, c["dir"]):
            return port
        if health:
            break        # somebody else's board; the rest of the sequence is theirs
    return None


# The board that last answered "what was chosen", as (host, port). Tried first
# next time, so an ordinary tick costs one request rather than a walk.
_ASKED = [None, None]


def node_choice(node, cands):
    """What the compute node says a PERSON chose over there, or None.

    `{"dir", "port", "at"}`, straight out of the first board that answers --
    every board on a machine publishes the same record, so the walk exists only
    to find somebody to ask.

    `at` is why this is separate from finding a board. The choice is recorded on
    whichever machine happened to be serving the hub when the course was tapped,
    so there are two records and only their timestamps can say which one is the
    person's latest word. A node running older code publishes no `at` and reads
    as ancient, which is the right way round: this machine's own record wins by
    default and nothing gets dragged off a lesson by a stale name.
    """
    hosts = [node] if node else []
    # And every machine that is actually up, for the same reason `remote_target`
    # asks them: `node` is a hostname out of a config file and a compute node's
    # hostname is an allocation. This is the half that was missed the first time,
    # and missing it is worse than useless -- the follower found the other
    # machine's BOARD through the peer walk and then never asked it what had been
    # chosen, so a tap over there was published, correct, and invisible. The
    # address stayed where it was while `/health` on both machines said plainly
    # that somebody had asked for the other course.
    hosts += [h for h in boardlib.tailnet_peers() if h != node]
    # Whoever answered last, first: an ordinary tick is then one request.
    if _ASKED[0] and _ASKED[1]:
        health = probe(_ASKED[0], _ASKED[1], timeout=1.5)
        if health:
            ch = health.get("chosen") or {}
            return ch if ch.get("dir") else None

    # Otherwise walk, and walk EVERY course rather than the first few. The other
    # machine is running whichever courses it is running, and the ones this
    # machine happens to list first are not them: the Mac probed Algo-Solutions,
    # Galois-Theory, Lean-Theorem-Proving and Mathematical-Modeling on a node
    # that was serving Probability, found nothing, and concluded that nobody had
    # chosen anything. A bound that looks harmless is how this failed twice.
    #
    # One board is enough -- every board on a machine publishes the same record
    # -- so it stops at the first answer and remembers where it came from.
    for host in hosts:
        for c in cands:
            port = default_port(c["root"])
            health = probe(host, port, timeout=1.0)
            if not health:
                continue
            _ASKED[0], _ASKED[1] = host, port
            ch = health.get("chosen") or {}
            return ch if ch.get("dir") else None
    return None


# The board on this machine that last answered "what was chosen".
_ASKED_LOCAL = [None]


def local_choice(cands):
    """What a board ON THIS MACHINE says was chosen.

    The follower reads that record off the filesystem, and it is not always the
    same filesystem view a board has: this process is started by launchd with
    whatever environment launchd hands it, and the boards are started from a
    session. When those disagree the follower is deciding from a file nobody is
    writing to, which looks exactly like a tap that does nothing -- the address
    stayed on Probability for ten minutes while every board on both machines
    published `chosen: Galois-Theory`, which is how this was found.

    So ask a board instead of only reading a file. They publish the record they
    actually wrote.
    """
    ports = ([_ASKED_LOCAL[0]] if _ASKED_LOCAL[0] else []) + \
            [default_port(c["root"]) for c in cands]
    for port in ports:
        health = probe("127.0.0.1", port, timeout=1.0)
        if not health:
            continue
        _ASKED_LOCAL[0] = port
        ch = health.get("chosen") or {}
        return ch if ch.get("dir") else None
    return None


def wanted_course(remote_choice, local_published=None):
    """Which COURSE the address opens, deciding across both machines.

    The newest decision wins, wherever it was made and whoever is reporting it.
    Three sources, because each one covers a way the others fail: this process's
    own copy of the record; what a board on this machine publishes, which is the
    same record read by a process that definitely wrote it; and what a board on
    the other machine publishes, since a course tapped in a hub served from over
    there is recorded over there and would otherwise never be seen here.
    """
    best = (0.0, None)
    for rec in (boardlib.chosen_course(), local_published, remote_choice):
        if not rec or not rec.get("dir"):
            continue
        try:
            at = float(rec.get("at") or 0)
        except (TypeError, ValueError):
            at = 0.0
        if at >= best[0]:
            best = (at, rec["dir"])
    return best[1]


def remote_target(node, cands, want=None, hint=None):
    """(host, port, exact) for a board on the compute node, or None.

    `exact` is the part that matters and the part that was missing: True when
    this board is serving the course that was actually chosen, False when it is
    merely the board that happened to answer over there. Both are useful -- an
    address with nothing behind it is worse than the wrong lesson, because the
    wrong lesson can be tapped out of -- but they are not the same thing, and
    treating them as the same is how a course nobody chose captured the address
    off a machine that was mid-proof. The caller decides what a fallback is
    allowed to beat; see `choose_target`.

    `hint` is the port the node published for the chosen course, checked before
    the sequence is walked, because the serving machine read it out of that
    course's own board record and is the only one that can know it.
    """
    by_name = dict((c["dir"], c) for c in cands)
    if not node:
        # No configured node is not the same as no other machine. The tailnet
        # knows who is up; ask it before giving up on the far side entirely.
        if want:
            found = boardlib.locate_course(want, skip_local=True, timeout=1.5)
            if found:
                return found[0], found[1], True
        return None

    if want:
        if hint:
            try:
                hint = int(hint)
            except (TypeError, ValueError):
                hint = None
        if hint and identifies_as(probe(node, hint), want):
            return node, hint, True
        if want in by_name:
            port = find_course(node, by_name[want])
            if port:
                return node, port, True

    # Not at the configured name. Ask the tailnet.
    #
    # `node` is a hostname out of a config file, and a compute node's hostname is
    # an allocation: it was `compute302` today and something else last week. When
    # it goes stale every probe above fails and the follower can see no board
    # anywhere but its own, for ever -- which from the iPad is "Galois Theory is
    # the only option, and when I tap Probability I can't switch". A course's
    # ports are derived from its name, so no configuration is needed to find one:
    # knock on every machine that is up.
    if want:
        found = boardlib.locate_course(want, skip_local=True, timeout=1.5)
        if found:
            return found[0], found[1], True

    # The chosen course is not up over there, or nobody has chosen anything.
    # Whatever is answering is better than nothing, and is marked as what it is.
    for c in cands:
        health = probe(node, default_port(c["root"]))
        if not health:
            continue
        if identifies_as(health, c["dir"]):
            return node, default_port(c["root"]), False
        # A board answering on a port that is not its own: find its real home
        # rather than trusting the number.
        port = find_course(node, c)
        if port:
            return node, port, False
    return None


def local_target(cands, want=None):
    """(host, port, exact) for a board answering on THIS machine, or None.

    The same two questions the remote side asks -- which course was chosen, and
    is the board that answers really that course -- put to 127.0.0.1. The record
    is consulted first because here, unlike over there, we can actually read it;
    the sequence is walked when it is wrong or missing.

    `want` is the course decided across both machines. When this machine has no
    clone of it, or no board up for it, whatever is active here is offered
    instead and marked inexact.
    """
    by_name = dict((c["dir"], c) for c in cands)
    active = by_name.get(want) if want else None
    exact = active is not None
    if active is None:
        active = active_course(cands)
    if not active:
        return None
    recorded = local_port(active)
    if identifies_as(probe("127.0.0.1", recorded, timeout=1.0), active["dir"]):
        return "127.0.0.1", recorded, exact
    for port in boardlib.port_sequence(active["dir"]):
        if port == recorded:
            continue
        health = probe("127.0.0.1", port, timeout=1.0)
        if identifies_as(health, active["dir"]):
            return "127.0.0.1", port, exact
        if health:
            break        # somebody else's board; the rest of the sequence is theirs
    return None


def choose_target(node, cands, prefer="local"):
    """Which machine gets the address this tick, and a phrase for the log.

    Four rules, in this order, and the order is the whole of it:

      1. A board serving the course that was CHOSEN beats one that is not, on
         either machine. This is the rule that was missing. Without it any board
         left running anywhere could capture the one address the iPad has, and it
         did: a lesson was taken off the machine teaching it and handed to an
         unrelated course on the other one, because that course's board was up
         and answering. A board that is merely up has no claim on the address.
      1.5. Among boards with an equal claim, one with a tutor attached beats one
         with nobody behind it. Two boards for one course is a state that should
         not exist and did: a tap in a hub started one wherever the tap landed.
      2. Among boards with an equal claim, one with an allowance beats one
         without. Two machines serving the same chosen course is exactly the case
         this decides, and it is unchanged: paid tutor, then the other machine,
         then the free model. Note it cannot demote a machine to a course nobody
         asked for -- a limited board still SHOWS the lesson, and only new turns
         fail, so the wrong lesson is strictly worse.
      3. Then `prefer`: "local" is the rule that a course cloned on this machine
         is taught on this machine; "node" is the original arrangement, where the
         compute node won because that is where the data and the hardware are.
      4. And never nothing while anything is up. An address with nothing behind
         it is the one outcome worse than the wrong machine, so when nothing is
         up anywhere the local port is still named -- the resume that is about to
         start a board there then lands on a live address rather than waiting for
         the next tick to be noticed.

    Returns ((host, port), phrase); the exactness flag is spent here and does not
    leave, because the follower's only question is whether the address moved.
    """
    remote_choice = node_choice(node, cands)
    want = wanted_course(remote_choice, local_choice(cands))

    local = local_target(cands, want) if cands else None
    remote = remote_target(node, cands, want, (remote_choice or {}).get("port"))

    order = [(remote, "the compute node"), (local, "here")] if prefer == "node" \
        else [(local, "here"), (remote, "the compute node")]
    order = [(t, w) for t, w in order if t]

    # Rule 1, as a stable partition: preference still decides between two boards
    # with the same claim, and never overrides the claim itself.
    order = ([x for x in order if x[0][2]] + [x for x in order if not x[0][2]])

    # Rule 1.5: among boards with the same claim, one with a tutor attached beats
    # one without. A stable partition again, so it cannot promote a board that
    # was not chosen -- an empty room is better than the wrong lesson, but a
    # lesson with nobody to teach it is worse than the same lesson with somebody.
    withtutor = [x for x in order if has_tutor(x[0][0], x[0][1])]
    without = [x for x in order if x not in withtutor]
    order = ([x for x in withtutor if x[0][2]] + [x for x in without if x[0][2]]
             + [x for x in withtutor if not x[0][2]]
             + [x for x in without if not x[0][2]])

    # Rule 2. Every one of these is a request over the network, so ask once each.
    graded = [(t, w, limited(t[0], t[1])) for t, w in order]
    for t, w, out in graded:
        if not out:
            return (t[0], t[1]), w
    if graded:
        t, w, _ = graded[0]
        return (t[0], t[1]), w + " (out of allowance, and so is everywhere else)"

    active = active_course(cands) if cands else None
    if active:
        return ("127.0.0.1", local_port(active)), "here (nothing up yet)"
    return None, None


def handover(host, port, secret, log):
    """Ask the machine we are leaving to wrap its tutor up before the address moves.

    Without it the outgoing tutor is simply orphaned: it goes on waiting on a
    board nobody can reach any more, and the one turn it is owed -- the handoff
    that is the only continuity there is between machines -- never happens.
    `/handover` was built for this exact moment and had no caller at all until the
    address started preferring this machine; now that the proxy moves on a policy
    rather than only on the node dying, the moment actually arrives.

    Best effort, and deliberately so. The address has to move whether or not the
    other machine is still there to be asked.
    """
    if not secret:
        log("no handover_secret configured; %s keeps its tutor" % host)
        return
    # A machine that is not answering has no tutor to wrap up, and asking it
    # anyway spends the request timeout on every move away from a host that has
    # died -- which is most of them.
    if not probe(host, port, timeout=2.0):
        return
    req = urllib.request.Request("http://%s:%d/handover" % (host, port),
                                 data=b"", method="POST",
                                 headers={"X-Handover": secret})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            doc = json.loads(resp.read(4096).decode("utf-8", "replace"))
        log("asked %s to hand over: %s" % (host, doc.get("detail") or doc))
    except (OSError, urllib.error.URLError, ValueError) as exc:
        log("could not ask %s to hand over: %s" % (host, exc))


class Target:
    def __init__(self):
        self._lock = threading.Lock()
        self._host = "127.0.0.1"
        self._port = 0

    def set(self, host, port):
        with self._lock:
            self._host, self._port = host, port

    def get(self):
        with self._lock:
            return self._host, self._port


class Proxy(socketserver.BaseRequestHandler):
    def handle(self):
        host, port = self.server.target.get()
        if not port:
            self.request.close()
            return
        try:
            upstream = socket.create_connection((host, port), timeout=10)
        except OSError:
            # Nothing answering where we pointed. Close rather than answer, and
            # the client's own "cannot reach the board" path takes over.
            self.request.close()
            return
        upstream.settimeout(None)
        self.request.settimeout(None)
        try:
            forward(self.request, upstream)
        finally:
            upstream.close()


def forward(a, b):
    """Pipe bytes both ways until one side hangs up, as a proxy must for SSE."""
    def pipe(src, dst):
        try:
            while True:
                data = src.recv(65536)
                if not data:
                    break
                dst.sendall(data)
        except OSError:
            pass
        finally:
            for s in (src, dst):
                try:
                    s.shutdown(socket.SHUT_WR)
                except OSError:
                    pass

    t = threading.Thread(target=pipe, args=(a, b), daemon=True)
    t.start()
    pipe(b, a)


def ensure_serve(listen):
    """Point the tailnet HTTPS name at this proxy. `tailscale serve` proxies to a
    local backend fine; it only refuses a remote one, which is why this exists."""
    prefix, kind = boardlib.tailscale_cli()
    if not prefix:
        return
    host, port = listen.rsplit(":", 1)
    cmd = prefix + ["serve", "--bg", "--https=443", "http://%s:%s" % (host, port)]
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=40)
    except (OSError, subprocess.TimeoutExpired):
        pass


def follower(target, node, cands, log, prefer="local", secret=None):
    """Re-decide where the address points, and act only when it changes.

    Acting only on a change is what makes the handover possible: the outgoing
    machine must be asked once, at the moment the address leaves it, and not
    every thirty seconds for as long as it stays gone. It also stops the log
    being a wall of the same line.
    """
    interval = float(os.environ.get("FOLLOW_INTERVAL", "30"))
    was = None
    while True:
        now, where = choose_target(node, cands, prefer)
        if now and now != was:
            # Any move between machines strands a tutor, because the machine
            # being left goes on running perfectly well with nobody able to
            # reach it -- still waiting, still writing cards into a copy the
            # iPad cannot see, and never given the turn that writes HANDOFF.md.
            # It used to be worth saying only in one direction, because the
            # address only ever left the node when the node had died and a dead
            # machine needs no telling. Now that an allowance can move the
            # address off a machine that is alive and mid-lesson, both
            # directions carry a live tutor, and `handover` itself is what
            # declines to bother a host that is not answering.
            if was and was[0] != now[0]:
                handover(was[0], was[1], secret, log)
            log("serving %s at %s:%d" % (where, now[0], now[1]))
            target.set(now[0], now[1])
            was = now
        time.sleep(interval)


def log(line):
    try:
        sys.stderr.write("[%s] %s\n" % (time.strftime("%H:%M:%S"), line))
        sys.stderr.flush()
    except (OSError, ValueError):
        pass


def _flag(argv, name):
    for i, a in enumerate(argv):
        if a == name and i + 1 < len(argv):
            return argv[i + 1]
    return None


def main(argv):
    cfg = load_config()
    follow = cfg.get("follow") or {}
    # A command-line flag beats the config, which beats an environment variable.
    # The config is the declared source of truth; the flags exist so a person (or
    # a test) can point the follower elsewhere without editing the file.
    node = _flag(argv, "--node") or follow.get("node") or os.environ.get("FOLLOW_NODE")
    listen = _flag(argv, "--listen") or follow.get("listen") \
        or os.environ.get("FOLLOW_LISTEN") or "127.0.0.1:8844"
    # A course cloned here is taught here, unless the config says otherwise.
    prefer = _flag(argv, "--prefer") or follow.get("prefer") or "local"

    if "--serve" in argv:
        ensure_serve(listen)
        return 0

    cands = courses(cfg)
    host, port = listen.rsplit(":", 1)
    port = int(port)

    target = Target()
    active = active_course(cands)
    if active:
        target.set("127.0.0.1", default_port(active["root"]))
    else:
        target.set("127.0.0.1", 0)

    threading.Thread(target=follower,
                     args=(target, node, cands, log, prefer,
                           cfg.get("handover_secret")),
                     daemon=True).start()
    # Only the configured follower owns the tailnet name. An ad-hoc instance run
    # on some other port (a probe, a test) must not steal `tailscale serve` from
    # the one that is actually answering.
    if not _flag(argv, "--listen"):
        ensure_serve(listen)

    server = socketserver.ThreadingTCPServer((host, port), Proxy)
    server.target = target
    server.daemon_threads = True
    log("preferring %s; following %s, listening on %s"
        % ("this machine" if prefer != "node" else "the compute node",
           node or "(no node configured)", listen))
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
